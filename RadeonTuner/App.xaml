            <Style x:Name="ApplicationSlider" TargetType="Slider">
                <!-- UseLayoutRounding fixes 125% DPI crash -->
                <Setter Property="UseLayoutRounding" Value="False"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{ThemeResource ThemeBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeNavIndicatorBrush}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.Resources>
                                    <Style TargetType="Thumb" x:Key="SliderThumbStyle">
                                        <Setter Property="Width" Value="16"/>
                                        <Setter Property="Height" Value="16"/>
                                        <Setter Property="BorderThickness" Value="0"/>
