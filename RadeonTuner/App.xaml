            <Style x:Key="ApplicationFanNumberBox" TargetType="TextBox" BasedOn="{StaticResource ApplicationTextBox}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="NumberBorder.Background" Value="{ThemeResource ThemeHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="NumberBorder.BorderBrush" Value="{ThemeResource ApplicationAccentLightBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="NumberBorder.Opacity" Value="0.45" />
                                                <Setter Target="ContentElement.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="NumberBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True" />
                                <ScrollViewer x:Name="ContentElement" Height="18" Margin="{TemplateBinding BorderThickness}" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" ZoomMode="Disabled" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ApplicationSliderNumberBox" TargetType="TextBox" BasedOn="{StaticResource ApplicationFanNumberBox}">
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="IsReadOnly" Value="False"/>
            </Style>

            <Style x:Name="ApplicationTextBoxNoHit" TargetType="TextBox">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource ApplicationControlCornerRadius}"/>
                <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="BorderElement" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="BorderElement.Opacity" Value="0.45"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Text}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                                    <ScrollViewer x:Name="ContentElement" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="PlaceholderTextContentPresenter" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="HeaderContentPresenter" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <Button x:Name="DeleteButton" Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="DescriptionPresenter" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Name="ApplicationTextBoxReadOnly" TargetType="TextBox">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource ApplicationControlCornerRadius}"/>
                <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- Compact native scrollbar: thin neutral thumb, transparent track.
                 Track/Thumb/RepeatButton parts stay native so wheel, keyboard, drag,
                 touch and high-contrast behavior remain platform-owned. -->
            <ControlTemplate x:Key="ApplicationScrollBarThumb" TargetType="Thumb">
                <Grid x:Name="ThumbRoot" Background="Transparent">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ThumbVisual.Background" Value="{ThemeResource ScrollBarThumbFillPointerOver}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ThumbVisual.Background" Value="{ThemeResource ScrollBarThumbFillPressed}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ThumbVisual.Background" Value="{ThemeResource ScrollBarThumbFillDisabled}" />
                                    <Setter Target="ThumbRoot.Opacity" Value="0.6" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="ThumbVisual" Background="{TemplateBinding Background}" CornerRadius="4" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="ApplicationScrollBarRepeatButton" TargetType="RepeatButton">
                <Grid Background="Transparent" />
            </ControlTemplate>

            <Style x:Key="ScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="MinWidth" Value="16" />
                <Setter Property="MinHeight" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                                <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarThumbFillDisabled}" />
                                                <Setter Target="HorizontalThumb.Background" Value="{ThemeResource ScrollBarThumbFillDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                        <VisualState x:Name="TouchIndicator">
                                            <VisualState.Setters>
                                                <Setter Target="HorizontalRoot.Visibility" Value="Collapsed" />
                                                <Setter Target="VerticalRoot.Visibility" Value="Collapsed" />
                                                <Setter Target="HorizontalPanningRoot.Visibility" Value="Visible" />
                                                <Setter Target="VerticalPanningRoot.Visibility" Value="Visible" />
                                                <Setter Target="HorizontalPanningRoot.Opacity" Value="1" />
                                                <Setter Target="VerticalPanningRoot.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="MouseIndicator">
                                            <VisualState.Setters>
                                                <Setter Target="HorizontalPanningRoot.Visibility" Value="Collapsed" />
                                                <Setter Target="VerticalPanningRoot.Visibility" Value="Collapsed" />
                                                <Setter Target="HorizontalPanningRoot.Opacity" Value="0" />
                                                <Setter Target="VerticalPanningRoot.Opacity" Value="0" />
                                                <Setter Target="HorizontalRoot.Visibility" Value="Visible" />
                                                <Setter Target="VerticalRoot.Visibility" Value="Visible" />
                                                <Setter Target="HorizontalRoot.IsHitTestVisible" Value="True" />
                                                <Setter Target="VerticalRoot.IsHitTestVisible" Value="True" />
                                                <Setter Target="HorizontalThumb.Opacity" Value="1" />
                                                <Setter Target="VerticalThumb.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NoIndicator">
                                            <VisualState.Setters>
                                                <Setter Target="VerticalThumb.Width" Value="{StaticResource ApplicationScrollBarThumbSize}" />
                                                <Setter Target="HorizontalThumb.Height" Value="{StaticResource ApplicationScrollBarThumbSize}" />
                                                <Setter Target="VerticalThumbTransform.X" Value="0" />
                                                <Setter Target="HorizontalThumbTransform.Y" Value="0" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimation Duration="{StaticResource ApplicationScrollBarOpacityDuration}" Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Opacity" To="0" />
                                                <DoubleAnimation Duration="{StaticResource ApplicationScrollBarOpacityDuration}" Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Opacity" To="0" />
                                                <DoubleAnimation Duration="{StaticResource ApplicationScrollBarOpacityDuration}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                                <DoubleAnimation Duration="{StaticResource ApplicationScrollBarOpacityDuration}" Storyboard.TargetName="HorizontalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                                <DoubleAnimation Duration="{StaticResource ApplicationScrollBarOpacityDuration}" Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Opacity" To="0" />
                                                <DoubleAnimation Duration="{StaticResource ApplicationScrollBarOpacityDuration}" Storyboard.TargetName="HorizontalPanningRoot" Storyboard.TargetProperty="Opacity" To="0" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalRoot" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="{StaticResource ApplicationScrollBarContractDuration}">
                                                        <DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value>
                                                    </DiscreteObjectKeyFrame>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalRoot" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="{StaticResource ApplicationScrollBarContractDuration}">
                                                        <DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value>
                                                    </DiscreteObjectKeyFrame>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ConsciousStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition From="Collapsed" To="Expanded" GeneratedDuration="0:0:0.12" />
                                            <VisualTransition From="Expanded" To="Collapsed" GeneratedDuration="0:0:0.12" />
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Collapsed">
                                            <VisualState.Setters>
                                                <Setter Target="VerticalThumb.Width" Value="{StaticResource ApplicationScrollBarThumbSize}" />
                                                <Setter Target="HorizontalThumb.Height" Value="{StaticResource ApplicationScrollBarThumbSize}" />
                                                <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarThumbFill}" />
                                                <Setter Target="HorizontalThumb.Background" Value="{ThemeResource ScrollBarThumbFill}" />
                                                <Setter Target="VerticalThumbTransform.X" Value="0" />
                                                <Setter Target="HorizontalThumbTransform.Y" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Expanded">
                                            <VisualState.Setters>
                                                <Setter Target="VerticalThumb.Width" Value="{StaticResource ApplicationScrollBarExpandedThumbSize}" />
                                                <Setter Target="HorizontalThumb.Height" Value="{StaticResource ApplicationScrollBarExpandedThumbSize}" />
                                                <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarThumbFillPointerOver}" />
                                                <Setter Target="HorizontalThumb.Background" Value="{ThemeResource ScrollBarThumbFillPointerOver}" />
                                                <Setter Target="VerticalThumbTransform.X" Value="0" />
                                                <Setter Target="HorizontalThumbTransform.Y" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="ExpandedWithoutAnimation">
                                            <VisualState.Setters>
                                                <Setter Target="VerticalThumb.Width" Value="{StaticResource ApplicationScrollBarExpandedThumbSize}" />
                                                <Setter Target="HorizontalThumb.Height" Value="{StaticResource ApplicationScrollBarExpandedThumbSize}" />
                                                <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarThumbFillPointerOver}" />
                                                <Setter Target="HorizontalThumb.Background" Value="{ThemeResource ScrollBarThumbFillPointerOver}" />
                                                <Setter Target="VerticalThumbTransform.X" Value="0" />
                                                <Setter Target="HorizontalThumbTransform.Y" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid x:Name="HorizontalRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False" Height="16" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="5" Fill="{ThemeResource ScrollBarTrackFill}" Stroke="{ThemeResource ScrollBarTrackStroke}" StrokeThickness="0" Opacity="0" />
                                    <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" IsTabStop="False" Width="0" Height="0" Visibility="Collapsed" />
                                    <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" IsTabStop="False" Interval="50" Opacity="0" Background="Transparent" Template="{StaticResource ApplicationScrollBarRepeatButton}" Width="0" AllowFocusOnInteraction="False" />
                                    <Thumb x:Name="HorizontalThumb" Grid.Column="2" Height="{StaticResource ApplicationScrollBarThumbSize}" MinWidth="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{ThemeResource ScrollBarThumbFill}" Template="{StaticResource ApplicationScrollBarThumb}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5,0.5">
                                        <Thumb.RenderTransform>
                                            <TranslateTransform x:Name="HorizontalThumbTransform" Y="0" />
                                        </Thumb.RenderTransform>
                                    </Thumb>
                                    <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" IsTabStop="False" Interval="50" Opacity="0" Background="Transparent" Template="{StaticResource ApplicationScrollBarRepeatButton}" AllowFocusOnInteraction="False" HorizontalAlignment="Stretch" />
                                    <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" IsTabStop="False" Width="0" Height="0" Visibility="Collapsed" />
                                </Grid>

                                <Grid x:Name="HorizontalPanningRoot" MinWidth="24" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Border x:Name="HorizontalPanningThumb" Height="6" MinWidth="32" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource ScrollBarPanningThumbBackground}" CornerRadius="4" />
                                </Grid>

                                <Grid x:Name="VerticalRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False" Width="16" HorizontalAlignment="Right">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="5" Fill="{ThemeResource ScrollBarTrackFill}" Stroke="{ThemeResource ScrollBarTrackStroke}" StrokeThickness="0" Opacity="0" />
                                    <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" IsTabStop="False" Width="0" Height="0" Visibility="Collapsed" />
                                    <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" IsTabStop="False" Interval="50" Opacity="0" Background="Transparent" Template="{StaticResource ApplicationScrollBarRepeatButton}" Height="0" AllowFocusOnInteraction="False" />
                                    <Thumb x:Name="VerticalThumb" Grid.Row="2" Width="{StaticResource ApplicationScrollBarThumbSize}" MinHeight="24" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{ThemeResource ScrollBarThumbFill}" Template="{StaticResource ApplicationScrollBarThumb}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5,0.5">
                                        <Thumb.RenderTransform>
                                            <TranslateTransform x:Name="VerticalThumbTransform" X="0" />
                                        </Thumb.RenderTransform>
                                    </Thumb>
                                    <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" IsTabStop="False" Interval="50" Opacity="0" Background="Transparent" Template="{StaticResource ApplicationScrollBarRepeatButton}" AllowFocusOnInteraction="False" VerticalAlignment="Stretch" />
                                    <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" IsTabStop="False" Width="0" Height="0" Visibility="Collapsed" />
                                </Grid>

                                <Grid x:Name="VerticalPanningRoot" MinHeight="24" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Border x:Name="VerticalPanningThumb" Width="6" MinHeight="32" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource ScrollBarPanningThumbBackground}" CornerRadius="4" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DefaultScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}" />

            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
