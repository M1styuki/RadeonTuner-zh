<Application x:Class="RadeonTuner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RadeonTuner">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme Color -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ThemeForegroundColor">#1B2028</Color>
                    <SolidColorBrush x:Key="ThemeForegroundBrush">#1B2028</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#FFFFFF</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundDarkColor">#EEF1F5</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundDarkBrush">#EEF1F5</SolidColorBrush>
                    <Color x:Key="ThemeBorderColor">#D3D9E2</Color>
                    <SolidColorBrush x:Key="ThemeBorderBrush">#D3D9E2</SolidColorBrush>
                    <Color x:Key="ThemeHoverColor">#E9EDF3</Color>
                    <SolidColorBrush x:Key="ThemeHoverBrush">#E9EDF3</SolidColorBrush>
                    <Color x:Key="ThemeControlColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="ThemeControlBrush">#FFFFFF</SolidColorBrush>
                    <Color x:Key="ThemeNavSelectedColor">#E4E9F1</Color>
                    <SolidColorBrush x:Key="ThemeNavSelectedBrush">#E4E9F1</SolidColorBrush>
                    <Color x:Key="ThemeNavIndicatorColor">#C93A3A</Color>
                    <SolidColorBrush x:Key="ThemeNavIndicatorBrush">#C93A3A</SolidColorBrush>
                    <Color x:Key="ApplicationDimGrayColor">#5B6472</Color>
                    <SolidColorBrush x:Key="ApplicationDimGrayBrush">#5B6472</SolidColorBrush>
                    <x:String x:Key="ThemeImageApps">/Assets/AppsDark.png</x:String>
                    <x:String x:Key="ThemeImageCheckmark">/Assets/CheckmarkDark.png</x:String>
                    <x:String x:Key="ThemeImageCross">/Assets/CrossDark.png</x:String>
                    <x:String x:Key="ThemeImageDisplay">/Assets/DisplayDark.png</x:String>
                    <x:String x:Key="ThemeImageDragDrop">/Assets/DragDropDark.png</x:String>
                    <x:String x:Key="ThemeImageExperimental">/Assets/ExperimentalDark.png</x:String>
                    <x:String x:Key="ThemeImageFans">/Assets/FansDark.png</x:String>
                    <x:String x:Key="ThemeImageGraphics">/Assets/GraphicsDark.png</x:String>
                    <x:String x:Key="ThemeImageInformation">/Assets/InformationDark.png</x:String>
                    <x:String x:Key="ThemeImageLink">/Assets/LinkDark.png</x:String>
                    <x:String x:Key="ThemeImageMultimedia">/Assets/MultimediaDark.png</x:String>
                    <x:String x:Key="ThemeImagePlus">/Assets/PlusDark.png</x:String>
                    <x:String x:Key="ThemeImagePower">/Assets/PowerDark.png</x:String>
                    <x:String x:Key="ThemeImageRemove">/Assets/RemoveDark.png</x:String>
                    <x:String x:Key="ThemeImageReset">/Assets/ResetDark.png</x:String>
                    <x:String x:Key="ThemeImageSettings">/Assets/SettingsDark.png</x:String>
                    <x:String x:Key="ThemeImageShield">/Assets/ShieldDark.png</x:String>
                    <x:String x:Key="ThemeImageShutdown">/Assets/ShutdownDark.png</x:String>
                    <x:String x:Key="ThemeImageTuning">/Assets/TuningDark.png</x:String>
                    <x:String x:Key="ThemeImageUnlink">/Assets/UnlinkDark.png</x:String>
                    <x:String x:Key="ThemeImageUpdate">/Assets/UpdateDark.png</x:String>
                    <x:String x:Key="ThemeImageVideocard">/Assets/VideocardDark.png</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ThemeForegroundColor">#F0F2F5</Color>
                    <SolidColorBrush x:Key="ThemeForegroundBrush">#F0F2F5</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundColor">#222730</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#222730</SolidColorBrush>
                    <Color x:Key="ThemeBackgroundDarkColor">#1B2028</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundDarkBrush">#1B2028</SolidColorBrush>
                    <Color x:Key="ThemeBorderColor">#343C48</Color>
                    <SolidColorBrush x:Key="ThemeBorderBrush">#343C48</SolidColorBrush>
                    <Color x:Key="ThemeHoverColor">#303946</Color>
                    <SolidColorBrush x:Key="ThemeHoverBrush">#303946</SolidColorBrush>
                    <Color x:Key="ThemeControlColor">#2A313C</Color>
                    <SolidColorBrush x:Key="ThemeControlBrush">#2A313C</SolidColorBrush>
                    <Color x:Key="ThemeNavSelectedColor">#2B3341</Color>
                    <SolidColorBrush x:Key="ThemeNavSelectedBrush">#2B3341</SolidColorBrush>
                    <Color x:Key="ThemeNavIndicatorColor">#E24646</Color>
                    <SolidColorBrush x:Key="ThemeNavIndicatorBrush">#E24646</SolidColorBrush>
                    <Color x:Key="ApplicationDimGrayColor">#AEB8C6</Color>
                    <SolidColorBrush x:Key="ApplicationDimGrayBrush">#AEB8C6</SolidColorBrush>
                    <x:String x:Key="ThemeImageApps">/Assets/Apps.png</x:String>
                    <x:String x:Key="ThemeImageCheckmark">/Assets/Checkmark.png</x:String>
                    <x:String x:Key="ThemeImageCross">/Assets/Cross.png</x:String>
                    <x:String x:Key="ThemeImageDisplay">/Assets/Display.png</x:String>
                    <x:String x:Key="ThemeImageDragDrop">/Assets/DragDrop.png</x:String>
                    <x:String x:Key="ThemeImageExperimental">/Assets/Experimental.png</x:String>
                    <x:String x:Key="ThemeImageFans">/Assets/Fans.png</x:String>
                    <x:String x:Key="ThemeImageGraphics">/Assets/Graphics.png</x:String>
                    <x:String x:Key="ThemeImageInformation">/Assets/Information.png</x:String>
                    <x:String x:Key="ThemeImageLink">/Assets/Link.png</x:String>
                    <x:String x:Key="ThemeImageMultimedia">/Assets/Multimedia.png</x:String>
                    <x:String x:Key="ThemeImagePlus">/Assets/Plus.png</x:String>
                    <x:String x:Key="ThemeImagePower">/Assets/Power.png</x:String>
                    <x:String x:Key="ThemeImageRemove">/Assets/Remove.png</x:String>
                    <x:String x:Key="ThemeImageReset">/Assets/Reset.png</x:String>
                    <x:String x:Key="ThemeImageSettings">/Assets/Settings.png</x:String>
                    <x:String x:Key="ThemeImageShield">/Assets/Shield.png</x:String>
                    <x:String x:Key="ThemeImageShutdown">/Assets/Shutdown.png</x:String>
                    <x:String x:Key="ThemeImageTuning">/Assets/Tuning.png</x:String>
                    <x:String x:Key="ThemeImageUnlink">/Assets/Unlink.png</x:String>
                    <x:String x:Key="ThemeImageUpdate">/Assets/Update.png</x:String>
                    <x:String x:Key="ThemeImageVideocard">/Assets/Videocard.png</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- System Color -->
            <Color x:Key="SystemAccentColor">#E24646</Color>
            <Color x:Key="SystemAccentColorDark1">#C93A3A</Color>
            <Color x:Key="SystemAccentColorDark2">#A82E2E</Color>
            <Color x:Key="SystemAccentColorDark3">#7E2222</Color>
            <Color x:Key="SystemAccentColorLight1">#EA5C5C</Color>
            <Color x:Key="SystemAccentColorLight2">#F07272</Color>
            <Color x:Key="SystemAccentColorLight3">#F58A8A</Color>

            <!-- Accent Color -->
            <Color x:Key="ApplicationAccentLightColor">#E24646</Color>
            <SolidColorBrush x:Key="ApplicationAccentLightBrush">#E24646</SolidColorBrush>
            <Color x:Key="ApplicationAccentDimColor">#C93A3A</Color>
            <SolidColorBrush x:Key="ApplicationAccentDimBrush">#C93A3A</SolidColorBrush>
            <Color x:Key="ApplicationAccentDarkColor">#A82E2E</Color>
            <SolidColorBrush x:Key="ApplicationAccentDarkBrush">#A82E2E</SolidColorBrush>
            <Color x:Key="ApplicationAccentVoidColor">#7E2222</Color>
            <SolidColorBrush x:Key="ApplicationAccentVoidBrush">#7E2222</SolidColorBrush>

            <!-- Basic Color -->
            <Color x:Key="ApplicationWhiteColor">#F0F2F5</Color>
            <SolidColorBrush x:Key="ApplicationWhiteBrush">#F0F2F5</SolidColorBrush>
            <Color x:Key="ApplicationBlackColor">#14171D</Color>
            <SolidColorBrush x:Key="ApplicationBlackBrush">#14171D</SolidColorBrush>
            <Color x:Key="ApplicationLightGrayColor">#CECECE</Color>
            <SolidColorBrush x:Key="ApplicationLightGrayBrush">#CECECE</SolidColorBrush>
            <Color x:Key="ApplicationDarkGrayColor">#424242</Color>
            <SolidColorBrush x:Key="ApplicationDarkGrayBrush">#424242</SolidColorBrush>
            <Color x:Key="ApplicationVoidGrayColor">#2A2A2A</Color>
            <SolidColorBrush x:Key="ApplicationVoidGrayBrush">#2A2A2A</SolidColorBrush>

            <!-- Other Color -->
            <Color x:Key="ApplicationValidColor">#1EB955</Color>
            <SolidColorBrush x:Key="ApplicationValidBrush">#1EB955</SolidColorBrush>
            <Color x:Key="ApplicationInvalidColor">#CD1928</Color>
            <SolidColorBrush x:Key="ApplicationInvalidBrush">#CD1928</SolidColorBrush>
            <Color x:Key="ApplicationIgnoredColor">#EE8F3F</Color>
            <SolidColorBrush x:Key="ApplicationIgnoredBrush">#EE8F3F</SolidColorBrush>

            <!-- Templates -->
            <ControlTemplate x:Name="ListViewItemTemplateRound" TargetType="ListViewItem">
                <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTransitions="{TemplateBinding ContentTransitions}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SystemAccentColorDark1}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOverSelected">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource SystemAccentColorDark1}"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOverPressed">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.40"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                                <Storyboard>
                                    <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="PressedSelected">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.40"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}"/>
                                </VisualState.Setters>
                                <Storyboard>
                                    <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter"/>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="DisabledStates">
                            <VisualState x:Name="Enabled"/>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.50"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ContentPresenter>
            </ControlTemplate>

            <ControlTemplate x:Key="ListViewItemTemplateNav" TargetType="ListViewItem">
                <ContentPresenter x:Name="NavContentPresenter" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="NavContentPresenter.Background" Value="{ThemeResource ThemeHoverBrush}"/>
                                    <Setter Target="NavContentPresenter.BorderBrush" Value="Transparent"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Target="NavContentPresenter.Background" Value="{ThemeResource ThemeNavSelectedBrush}"/>
                                    <Setter Target="NavContentPresenter.BorderBrush" Value="{ThemeResource ThemeNavIndicatorBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOverSelected">
                                <VisualState.Setters>
                                    <Setter Target="NavContentPresenter.Background" Value="{ThemeResource ThemeHoverBrush}"/>
                                    <Setter Target="NavContentPresenter.BorderBrush" Value="{ThemeResource ThemeNavIndicatorBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="NavContentPresenter.Opacity" Value="0.70"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PressedSelected">
                                <VisualState.Setters>
                                    <Setter Target="NavContentPresenter.Opacity" Value="0.70"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="DisabledStates">
                            <VisualState x:Name="Enabled"/>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="NavContentPresenter.Opacity" Value="0.45"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ContentPresenter>
            </ControlTemplate>

            <ControlTemplate x:Key="ButtonTemplateHover" TargetType="Button">
                <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTransitions="{TemplateBinding ContentTransitions}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ThemeHoverBrush}"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.85"/>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ThemeHoverBrush}"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
                                </VisualState.Setters>
                                <Storyboard>
                                    <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="ContentPresenter.Opacity" Value="0.45"/>
                                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ThemeBackgroundDarkBrush}"/>
                                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ApplicationDimGrayBrush}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ContentPresenter>
            </ControlTemplate>

            <!-- Typography -->
            <FontFamily x:Key="ApplicationFontFamily">Microsoft YaHei UI</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="ApplicationSectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="26"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>

            <Style x:Key="ApplicationOverlayTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="28"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>

            <!-- Elements -->
            <Style x:Name="ApplicationListView" TargetType="ListView">
                <Setter Property="ItemContainerStyle" Value="{ThemeResource ApplicationListViewItem}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Name="ApplicationListViewDark" TargetType="ListView">
                <Setter Property="ItemContainerStyle" Value="{ThemeResource ApplicationListViewItemDark}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ApplicationNavListView" TargetType="ListView">
                <Setter Property="ItemContainerStyle" Value="{ThemeResource ApplicationNavListViewItem}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="4,10,6,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ApplicationNavListViewItem" TargetType="ListViewItem">
                <Setter Property="Margin" Value="4,2,8,2"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{ThemeResource ListViewItemTemplateNav}"/>
            </Style>

            <Style x:Name="ApplicationListViewItem" TargetType="ListViewItem">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{ThemeResource ThemeBackgroundBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{ThemeResource ListViewItemTemplateRound}"/>
            </Style>

            <Style x:Name="ApplicationListViewItemDark" TargetType="ListViewItem">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{ThemeResource ThemeBackgroundDarkBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{ThemeResource ListViewItemTemplateRound}"/>
            </Style>

            <Style x:Name="ApplicationSlider" TargetType="Slider">
                <!-- UseLayoutRounding fixes 125% DPI crash -->
                <Setter Property="UseLayoutRounding" Value="False"/>
            </Style>

            <Style x:Key="ApplicationMessageBoxListView" TargetType="ListView">
                <Setter Property="ItemContainerStyle" Value="{ThemeResource ApplicationMessageBoxListViewItem}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ApplicationMessageBoxListViewItem" TargetType="ListViewItem">
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Template" Value="{ThemeResource ListViewItemTemplateRound}"/>
            </Style>

            <Style x:Name="ApplicationComboBox" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Name="ApplicationButton" TargetType="Button">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="{ThemeResource ThemeControlBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template" Value="{ThemeResource ButtonTemplateHover}"/>
            </Style>

            <Style x:Name="ApplicationButtonImage" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeForegroundBrush}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template" Value="{ThemeResource ButtonTemplateHover}"/>
            </Style>

            <Style x:Name="ApplicationTextBox" TargetType="TextBox">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Name="ApplicationTextBoxNoHit" TargetType="TextBox">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Name="ApplicationTextBoxReadOnly" TargetType="TextBox">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
