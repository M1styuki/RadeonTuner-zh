                                        <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningRed.png" ToolTipService.ToolTip="* 启用此设置会破坏 HDR 兼容性。&#10;&#10;* 需要重启系统才能生效。"/>
                                        <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_OpenGL10BitPixelFormat_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_OpenGL10BitPixelFormat" OnContent="" OffContent="" AutomationProperties.Name="OpenGL 10 位像素格式" Toggled="toggleswitch_OpenGL10BitPixelFormat_Toggled"/>
                                    </Grid>
                                </Border>

                                <!-- Tessellation Mode -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
