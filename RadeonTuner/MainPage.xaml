                                        <ComboBox x:Name="combobox_Tessellation_Mode" Margin="0,2,0,0" Width="320" HorizontalAlignment="Left" SelectionChanged="combobox_Tessellation_Mode_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
