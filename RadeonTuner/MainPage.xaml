                                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="降低流体运动可能带来的性能开销，但可能降低高运动场景中的画质。"/>
                                                        <TextBlock Margin="10,0,0,0" Text="性能模式" VerticalAlignment="Center"/>
