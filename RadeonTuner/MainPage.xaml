                                            <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 需要在应用程序中启用“各向异性”等纹理过滤类型才能生效。&#10;&#10;* 此设置不适用于 DirectX 12 和 Vulkan 应用程序。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_TextureFilteringQuality_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
