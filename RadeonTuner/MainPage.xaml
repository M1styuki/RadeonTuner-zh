                                </Grid>
                            </Border>
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <Grid MinWidth="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
