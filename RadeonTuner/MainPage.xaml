                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="整数缩放使放大以适配显示器的图像呈现清晰、像素化的外观；无法按显示器精确尺寸和形状缩放的图像将居中显示。&#10;&#10;整数缩放可增强旧游戏的画面，在现代显示器上重现经典游戏体验。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Display_IntegerScaling" Margin="10,0,0,0" OffContent="整数缩放" OnContent="整数缩放" Toggled="toggleswitch_Display_IntegerScaling_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_IntegerScaling_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

