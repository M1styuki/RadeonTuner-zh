                                        <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="用于拉伸和定位图像以适配显示器的方法。&#10;&#10;- 保持纵横比：在适配显示器的同时保持图像原始纵横比。&#10;&#10;- 全屏面板：拉伸图像以填满整个显示器。&#10;&#10;- 居中：将图像居中显示，并保持原始纵横比和像素比例。"/>
                                                <TextBlock Text="缩放模式" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ScalingMode_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
                                            <ComboBox x:Name="combobox_Display_ScalingMode" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_ScalingMode_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="电源选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Vari-Bright -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="Vari-Bright 根据图像内容自适应调整显示亮度，从而节省电量。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此功能仅适用于笔记本电脑。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Display_VariBright" Margin="10,0,0,0" OffContent="Vari-Bright" OnContent="Vari-Bright" Toggled="toggleswitch_Display_VariBright_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_VariBright_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Vari-Bright Level -->
                                        <StackPanel Margin="0,5,0,0" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Vari-Bright 级别" VerticalAlignment="Center"/>
                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_VariBright_Level_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
                                            <ComboBox x:Name="combobox_Display_VariBright_Level" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_VariBright_Level_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="格式选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <!-- Color Depth -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="显示器使用的色深。"/>
                                                <TextBlock Text="色深" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ColorDepth_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
                                            <ComboBox x:Name="combobox_Display_ColorDepth" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_ColorDepth_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Pixel Format -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="用于为显示器编码图像的像素格式。"/>
                                                <TextBlock Text="像素格式" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_PixelFormat_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
                                            <ComboBox x:Name="combobox_Display_PixelFormat" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_PixelFormat_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Color Adjustment -->
                                <TextBlock Text="颜色调整" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Brightness -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="亮度" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Brightness_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Brightness" Text="{Binding ElementName=slider_Display_Brightness, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Brightness" Margin="10,0,0,0" ValueChanged="slider_Display_Brightness_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Contrast -->
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <TextBlock Text="对比度" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Contrast_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Contrast" Text="{Binding ElementName=slider_Display_Contrast, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Contrast" Margin="10,0,0,0" ValueChanged="slider_Display_Contrast_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Saturation -->
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <TextBlock Text="饱和度" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Saturation_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>

                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Saturation" Text="{Binding ElementName=slider_Display_Saturation, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Saturation" Margin="10,0,0,0" ValueChanged="slider_Display_Saturation_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Hue -->
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <TextBlock Text="色调" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Hue_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Hue" Text="{Binding ElementName=slider_Display_Hue, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Hue" Margin="10,0,0,0" ValueChanged="slider_Display_Hue_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Display Color Enhancement -->
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="内置 LUT 配置，可提升显示内容的清晰度和色彩鲜艳度。&#10;&#10;- 鲜艳游戏：增强整体亮度和色彩丰富度。&#10;&#10;- 动态对比度：提升暗部细节的可见性。"/>
                                                <TextBlock Text="显示色彩增强" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_DisplayColorEnhancement_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
                                            <ComboBox x:Name="combobox_Display_DisplayColorEnhancement" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Display_DisplayColorEnhancement_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Color Temperature -->
                                <TextBlock Text="色温" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Control -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="启用或禁用色温控制。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 禁用“色温控制”后，色彩将被限制在较窄的色域内，可能导致启用 HDR 的显示器出现过度饱和和色彩准确度下降。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Display_ColorTemperature_Control" Margin="10,0,0,0" OffContent="色温控制" OnContent="色温控制" Toggled="toggleswitch_Display_ColorTemperature_Control_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ColorTemperature_Control_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Kelvin -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="选择显示器上图像的冷暖色调。"/>
                                            <TextBlock Text="色温（开尔文）" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_ColorTemperature_Kelvin_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_ColorTemperature" Text="{Binding ElementName=slider_Display_ColorTemperature_Kelvin, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_ColorTemperature_Kelvin" Margin="10,0,0,0" ValueChanged="slider_Display_ColorTemperature_Kelvin_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Color Deficiency Correction -->
                                <TextBlock Text="色觉缺陷校正" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Control -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="启用或禁用无障碍模式，使存在不同程度色觉缺陷的用户可以调整颜色。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Display_CVDC_Control" Margin="10,0,0,0" OffContent="色觉缺陷校正控制" OnContent="色觉缺陷校正控制" Toggled="toggleswitch_Display_CVDC_Control_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_CVDC_Control_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Protanopia -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="针对红色盲的颜色调整。"/>
                                            <TextBlock Text="红色盲校正" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Protanopia_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Protanopia" Text="{Binding ElementName=slider_Display_Protanopia, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Protanopia" Margin="10,0,0,0" ValueChanged="slider_Display_Protanopia_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Deuteranopia -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="针对绿色盲的颜色调整。"/>
                                            <TextBlock Text="绿色盲校正" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Deuteranopia_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Deuteranopia" Text="{Binding ElementName=slider_Display_Deuteranopia, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Deuteranopia" Margin="10,0,0,0" ValueChanged="slider_Display_Deuteranopia_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Tritanopia -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="针对蓝色盲的颜色调整。"/>
                                            <TextBlock Text="蓝色盲校正" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Tritanopia_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Display_Tritanopia" Text="{Binding ElementName=slider_Display_Tritanopia, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Display_Tritanopia" Margin="10,0,0,0" ValueChanged="slider_Display_Tritanopia_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Override Options -->
                                <TextBlock Text="覆盖选项" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <!-- HDCP Support -->
                                <Border Margin="0,5,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="如果在此显示器上禁用高带宽数字内容保护（HDCP），受数字保护的内容可能无法播放，或只能以较低分辨率播放。"/>
                                            <Image Source="/Assets/WarningRed.png" Width="24" Height="24" ToolTipService.ToolTip="* 需要重启系统才能生效。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Display_HDCPSupport" Margin="10,0,0,0" OffContent="HDCP 支持" OnContent="HDCP 支持" Toggled="toggleswitch_Display_HDCPSupport_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_HDCPSupport_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Custom Resolutions -->
                                <TextBlock Text="自定义分辨率" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,5,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="创建自定义分辨率或对显示器刷新率进行超频。"/>
                                        <Button x:Name="button_CustomResolution_Create" Margin="10,0,0,0" Content="创建自定义分辨率" Click="button_CustomResolution_ShowHide_Click" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="创建新的自定义分辨率"/>
                                        <Button x:Name="button_CustomResolution_Remove" Content="删除自定义分辨率" Click="button_CustomResolution_Remove_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="删除自定义分辨率"/>
                                    </StackPanel>
                                </Border>

                                <!-- Eyefinity Options -->
                                <TextBlock Text="Eyefinity 选项" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,5,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Automatic Eyefinity -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="Eyefinity 可将多台显示器组合成一块大屏幕。&#10;&#10;自动 Eyefinity 会在显示配置中的应用程序运行时自动启用 Eyefinity，并在应用程序退出后禁用。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 启动应用程序后，可能需要几秒钟才会激活 Eyefinity。&#10;&#10;* 此设置仅在 RadeonTuner 运行时有效。"/>
                                            <Image x:Name="image_Eyefinity_Automatic_Profile_Used" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="某个应用程序配置已启用自动 Eyefinity，并且当前正在控制其状态。如需手动控制 Eyefinity，请在所有应用程序配置中禁用“自动 Eyefinity”。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Eyefinity_Automatic" Margin="10,0,0,0" OffContent="自动 Eyefinity" OnContent="自动 Eyefinity" Toggled="toggleswitch_Eyefinity_Automatic_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Eyefinity_Automatic_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Buttons Eyefinity -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="button_Eyefinity_Manage" Content="管理 Eyefinity" Click="button_Eyefinity_Manage_Click" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="管理 Eyefinity 设置。"/>
                                            <Button x:Name="button_Eyefinity_Enable" Content="启用 Eyefinity" Click="button_Eyefinity_Enable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 未激活时启用它。"/>
                                            <Button x:Name="button_Eyefinity_Disable" Content="禁用 Eyefinity" Click="button_Eyefinity_Disable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 已激活时禁用它。"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Access Overlay -->
                            <Grid x:Name="stackpanel_Display_AccessOverlay" CornerRadius="8" Visibility="Collapsed">
                                <Grid.Background>
                                    <SolidColorBrush Color="{ThemeResource ThemeBackgroundDarkColor}" Opacity="0.90"/>
                                </Grid.Background>

                                <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="无法访问所选显示器，&#10;请重新选择显示器……" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Multimedia -->
                        <Grid  x:Name="stackpanel_Multimedia" Visibility="Collapsed">
                            <!-- Settings -->
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="视频选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                    <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Background="{ThemeResource ThemeBackgroundBrush}">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Image x:Name="image_Multimedia_Used" Source="{ThemeResource ThemeImageCheckmark}" Margin="5,0,5,0" Width="24" Height="24" ToolTipService.ToolTip="当前正在使用此应用程序配置。"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Video Upscaling -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="视频超分辨率通过提升视频播放分辨率并调整细节来改善视频播放质量，带来更好的视觉体验。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置不适用于使用 HDR 的视频。&#10;&#10;* 此设置仅适用于 RDNA3 及更新显卡。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Video_Upscaling" Margin="10,0,0,0" OffContent="视频超分辨率" OnContent="视频超分辨率" Toggled="toggleswitch_Video_Upscaling_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Video_Upscaling_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Sharpening amount -->
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <TextBlock Text="锐化程度"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Video_Sharpening_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_VideoUpscale_Sharpening" Text="{Binding ElementName=slider_Video_Sharpening, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Video_Sharpening" Margin="10,0,0,0" ValueChanged="slider_Video_Sharpening_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Video Brightness -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="视频亮度"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Video_Brightness_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Video_Brightness" Text="{Binding ElementName=slider_Video_Brightness, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Video_Brightness" Margin="10,0,0,0" ValueChanged="slider_Video_Brightness_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Access Overlay -->
                            <Grid x:Name="stackpanel_Multimedia_AccessOverlay" CornerRadius="8" Visibility="Collapsed">
                                <Grid.Background>
                                    <SolidColorBrush Color="{ThemeResource ThemeBackgroundDarkColor}" Opacity="0.90"/>
                                </Grid.Background>

                                <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="无法访问所选显卡，&#10;请重新选择显卡……" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Settings -->
                        <StackPanel x:Name="stackpanel_Settings" Visibility="Collapsed">
                            <TextBlock Text="启动设置" Style="{ThemeResource ApplicationSectionHeader}"/>
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="在 Windows 启动时自动运行 RadeonTuner。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Shortcut_Startup" Margin="10,0,0,0" OffContent="Windows 启动时运行" OnContent="Windows 启动时运行" Toggled="toggleswitch_Shortcut_Startup_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="将 RadeonTuner 快捷方式添加到开始菜单的应用程序列表。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Shortcut_StartMenu" Margin="10,0,0,0" OffContent="将应用程序添加到开始菜单" OnContent="将应用程序添加到开始菜单" Toggled="toggleswitch_Shortcut_StartMenu_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,5,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="将 RadeonTuner 添加到 Windows 桌面右键菜单。"/>
                                        <Image x:Name="toggleswitch_Shortcut_ContextMenu_AdminShield" Source="{ThemeResource ThemeImageShield}" Width="24" Height="24" ToolTipService.ToolTip="更改此设置需要管理员权限；启用后，你可以继续以普通用户身份使用 RadeonTuner。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Shortcut_ContextMenu" Margin="10,0,0,0" OffContent="将应用程序添加到右键菜单" OnContent="将应用程序添加到右键菜单" Toggled="toggleswitch_Shortcut_ContextMenu_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="窗口设置" Style="{ThemeResource ApplicationSectionHeader}" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="启动此应用程序时显示设置窗口。"/>
                                        <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 如果已有另一个 RadeonTuner 实例在运行，此设置将被忽略，并显示已运行实例的窗口。"/>
                                        <ToggleSwitch x:Name="toggleswitch_StartWindowVisible" Margin="10,0,0,0" OffContent="启动时显示窗口" OnContent="启动时显示窗口" Toggled="toggleswitch_StartWindowVisible_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="将此窗口显示在其他应用程序之上。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Window_Top" Margin="10,0,0,0" OffContent="窗口置顶" OnContent="窗口置顶" Toggled="toggleswitch_Window_Top_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="关闭应用程序时最小化到系统托盘，而不是退出。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Close_Tray" Margin="10,0,0,0" OffContent="关闭到系统托盘" OnContent="关闭到系统托盘" Toggled="toggleswitch_Close_Tray_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,5,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="隐藏后可再次运行程序打开窗口，后台功能继续运行。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Hide_Tray_Icon" Margin="10,0,0,0" OffContent="隐藏托盘图标" OnContent="隐藏托盘图标" Toggled="toggleswitch_Hide_Tray_Icon_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="主题设置" Style="{ThemeResource ApplicationSectionHeader}" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="主题颜色样式" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="combobox_ThemeStyle" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_ThemeStyle_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>

                                    <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="将彩色应用程序图标替换为黑白单色版本。"/>
                                        <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 更改此设置需要重启 RadeonTuner 才能生效。"/>
                                        <ToggleSwitch x:Name="toggleswitch_ThemeIconMono" Margin="10,0,0,0" OffContent="显示单色应用程序图标" OnContent="显示单色应用程序图标" Toggled="toggleswitch_ThemeIconMono_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="实验性设置" Style="{ThemeResource ApplicationSectionHeader}" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="显示用于测试目的的实验性设置；其中部分设置使用占位值。"/>
                                        <ToggleSwitch x:Name="toggleswitch_ShowExperimental" Margin="10,0,0,0" OffContent="显示实验性设置" OnContent="显示实验性设置" Toggled="toggleswitch_ShowExperimental_Toggled"/>
                                    </StackPanel>

                                    <Border Margin="0,5,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="RadeonTuner 会向驱动程序确认是否支持某项显卡功能。启用此设置可跳过检查，以便测试不受支持的功能。"/>
                                        <ToggleSwitch x:Name="toggleswitch_SkipSupportCheckGraphics" Margin="10,0,0,0" OffContent="跳过显卡支持检查" OnContent="跳过显卡支持检查" Toggled="toggleswitch_SkipSupportCheckGraphics_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="更新设置" Style="{ThemeResource ApplicationSectionHeader}" Margin="0,10,0,0"/>
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="启动此应用程序时检查是否有可用更新。"/>
                                        <ToggleSwitch x:Name="toggleswitch_StartCheckUpdate" Margin="10,0,0,0" OffContent="启动时检查更新" OnContent="启动时检查更新" Toggled="toggleswitch_StartCheckUpdate_Toggled"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Information -->
                        <StackPanel x:Name="stackpanel_Information" Visibility="Collapsed">
                            <TextBlock Text="GPU 信息" Style="{ThemeResource ApplicationSectionHeader}"/>
                            <Border Margin="0,5,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock x:Name="textblock_GpuInfo" Text="..." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="显示信息" Style="{ThemeResource ApplicationSectionHeader}"/>
                            <Border Margin="0,5,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock x:Name="textblock_DisplayInfo" Text="..." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Text="应用程序信息" Style="{ThemeResource ApplicationSectionHeader}"/>
                            <Border Margin="0,5,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock x:Name="textblock_AppInfo" Text="..." TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Overlay - Manage Eyefinity -->
        <Grid x:Name="grid_Overlay_ManageEyefinity" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalContentAlignment="Center" Padding="20">
            <StackPanel MinWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,12">
                    <TextBlock Text="管理 Eyefinity" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}"/>
                </Border>
                <Border CornerRadius="0,0,10,10" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,18">
                    <StackPanel>
                        <!-- Buttons -->
                        <ScrollViewer Margin="0,5,0,0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/WarningOrange.png" Width="28" Height="28" ToolTipService.ToolTip="* 创建 Eyefinity 仅在连接并开启多台显示器且处于“复制”或“扩展”显示模式时有效；如果 Eyefinity 已启用，下方列表中将只显示一台显示器。&#10;&#10;* 需要启用 Eyefinity 才能移除配置。&#10;&#10;* 创建或启用 Eyefinity 后，请确保设置了正确的分辨率。&#10;&#10;* 如果创建后无法移除或禁用 Eyefinity，请尝试使用相同设置创建新配置。"/>
                                <Button x:Name="button_Eyefinity_Overlay_Create" Content="创建 Eyefinity" Click="button_Eyefinity_Overlay_Create_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="根据下方设置创建配置并启用 Eyefinity。"/>
                                <Button x:Name="button_Eyefinity_Overlay_Remove" Content="移除 Eyefinity" Click="button_Eyefinity_Overlay_Remove_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除配置并禁用 Eyefinity。"/>
                                <Button x:Name="button_Eyefinity_Overlay_Enable" Content="启用 Eyefinity" Click="button_Eyefinity_Enable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 未激活时启用它。"/>
                                <Button x:Name="button_Eyefinity_Overlay_Disable" Content="禁用 Eyefinity" Click="button_Eyefinity_Disable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 已激活时禁用它。"/>
                                <Button x:Name="button_Eyefinity_Overlay_Close" Content="关闭" Click="button_Eyefinity_Manage_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="关闭 Eyefinity 管理覆盖层。"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                        <!-- Rows -->
                        <TextBlock Text="水平显示器数量" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ElementName=slider_Eyefinity_Rows, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                            <Slider Grid.Column="1" x:Name="slider_Eyefinity_Rows" Margin="10,0,0,0" Minimum="1" Maximum="6" Style="{ThemeResource ApplicationSlider}"/>
                        </Grid>

                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                        <!-- Columns -->
                        <TextBlock Text="垂直显示器数量" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ElementName=slider_Eyefinity_Columns, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                            <Slider Grid.Column="1" x:Name="slider_Eyefinity_Columns" Margin="10,0,0,0" Minimum="1" Maximum="6" Style="{ThemeResource ApplicationSlider}"/>
                        </Grid>

                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                        <!-- Display Placement Order -->
                        <TextBlock Text="显示器排列顺序" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{ThemeResource ThemeImageDragDrop}" Width="30" Height="30" ToolTipService.ToolTip="按所需顺序拖放显示器，从左到右、从上到下排列。"/>
                            <ListView Grid.Column="1" x:Name="listview_EyefinityMonitorIndex" Margin="5,0,0,0" Height="40" SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DisplayDetailsIdl">
                                        <Border CornerRadius="4" BorderThickness="2" BorderBrush="{ThemeResource ApplicationDimGrayColor}" Margin="-10">
                                            <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" Margin="5"/>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                        <!-- Display Orientation -->
                        <TextBlock Text="显示方向" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="combobox_EyefinityMonitorOrientation" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Overlay - Custom Resolution -->
        <Grid x:Name="grid_Overlay_CustomResolution" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalContentAlignment="Center" Padding="20">
            <StackPanel MinWidth="520" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,12">
                    <TextBlock Text="自定义分辨率" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}"/>
                </Border>
                <Border CornerRadius="0,0,10,10" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,18">
                    <StackPanel>
                        <!-- Timing Standard -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="时序标准" VerticalAlignment="Center"/>
                                <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="用于显示器时序计算的标准。&#10;&#10;- 显示器时序（Display）&#10;显示器当前使用的时序，仅适用于已有分辨率和刷新率。&#10;&#10;- 协调视频时序（CVT）&#10;用于生成和定义显示器时序的 VESA 标准。&#10;&#10;- 协调视频时序减少消隐（CVT-RB）&#10;减少消隐期，允许更低的像素时钟和更高的帧率。&#10;&#10;- 通用时序公式（GTF）&#10;一种生成行业标准显示器时序的方法。&#10;&#10;- 显示器监视器时序（DMT）&#10;VESA 标准，列出了各种分辨率和显示器尺寸的预定义时序。"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1" x:Name="combobox_CustomResolution_TimingStandard" Width="300" Style="{ThemeResource ApplicationComboBox}" HorizontalAlignment="Right" SelectionChanged="combobox_CustomResolution_TimingStandard_SelectionChanged"/>
                        </Grid>

                        <Border Margin="0,10,0,5" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                        <!-- Resolution -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="分辨率（像素）" VerticalAlignment="Center"/>
                                <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="显示屏上水平像素（从左到右）和垂直像素（从上到下）的数量。"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="textbox_CustomResolution_Width" Width="129" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_Resolution_TextChanged"/>
                                <TextBlock Text="宽" Margin="5,0,8,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="textbox_CustomResolution_Height" Width="129" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_Resolution_TextChanged"/>
                                <TextBlock Text="高" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Refresh Rate -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="刷新率（Hz）" VerticalAlignment="Center"/>
                                <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="屏幕每秒重绘的次数，以赫兹表示。"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="textbox_CustomResolution_RefreshRate" Width="278" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_RefreshRate_TextChanged"/>
                                <TextBlock Text="Hz" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Presentation -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="扫描方式" VerticalAlignment="Center"/>
                                <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="图像呈现到屏幕的方式。&#10;&#10;- 逐行：整幅画面一次性绘制，可大幅减少屏幕闪烁。&#10;&#10;- 隔行：屏幕先显示半幅画面，另一半随后立即显示。"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1" x:Name="combobox_CustomResolution_Presentation" Width="300" Style="{ThemeResource ApplicationComboBox}" HorizontalAlignment="Right" SelectionChanged="combobox_CustomResolution_Presentation_SelectionChanged"/>
                        </Grid>

                        <Border Margin="0,10,0,10" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                        <!-- Manual settings -->
                        <StackPanel x:Name="stackpanel_CustomResolution_Manual">
                            <!-- Pixel Clock -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="像素时钟（MHz）" VerticalAlignment="Center"/>
                                    <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="在一个刷新周期内传输像素的速度。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_CustomResolution_PixelClock" Width="266" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_CustomResolution_PixelClock_TextChanged"/>
                                    <TextBlock Text="MHz" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Actual Refresh Rate -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="实际刷新率（Hz）" VerticalAlignment="Center"/>
                                    <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="GPU 每秒可写入显存的最大像素量。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_CustomResolution_ActualRefreshRate" Width="278" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" IsEnabled="False"/>
                                    <TextBlock Text="Hz" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,10" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                            <!-- Timing Total -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="时序总计" VerticalAlignment="Center"/>
                                    <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="每次同步的总水平像素和垂直像素数。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_TimingTotal_Horizontal" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingTotal_TextChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="textbox_TimingTotal_Vertical" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingTotal_TextChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timing Front Porch -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="前肩时序" VerticalAlignment="Center"/>
                                    <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="有效区域结束到下一次同步之间的水平像素和垂直像素数。（显示器右侧/底部到实际图像最右/最下部分之间的距离）"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_TimingFrontPorch_Horizontal" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingFrontPorch_TextChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="textbox_TimingFrontPorch_Vertical" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingFrontPorch_TextChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timing Sync Width -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="同步宽度" VerticalAlignment="Center"/>
                                    <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="同步期间的水平像素和垂直像素数。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="textbox_TimingSyncWidth_Horizontal" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingSyncWidth_TextChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="textbox_TimingSyncWidth_Vertical" Width="118" Style="{ThemeResource ApplicationTextBox}" InputScope="Number" TextChanged="textbox_TimingSyncWidth_TextChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timing Sync Polarity -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="同步极性" VerticalAlignment="Center"/>
                                    <Image Source="{ThemeResource ThemeImageInformation}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="同步信号的水平极性和垂直极性。&#10;&#10;正极性使信号高电平有效，负极性使信号低电平有效。"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="combobox_TimingPolarity_Horizontal" Width="118" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_TimingPolarity_SelectionChanged"/>
                                    <TextBlock Text="水平" Margin="5,0,10,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="combobox_TimingPolarity_Vertical" Width="118" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_TimingPolarity_SelectionChanged"/>
                                    <TextBlock Text="垂直" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Buttons -->
                        <Button x:Name="button_Overlay_CustomResolution_Create" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_CustomResolution_Create_Click" Content="创建" Style="{ThemeResource ApplicationButton}"/>
                        <Button x:Name="button_Overlay_CustomResolution_Close" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_CustomResolution_Close_Click" Content="关闭" Style="{ThemeResource ApplicationButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Overlay - Confirm Resolution -->
        <Grid x:Name="grid_Overlay_ConfirmResolution" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalContentAlignment="Center" Padding="20">
            <StackPanel MinWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,12">
                    <TextBlock x:Name="textblock_Overlay_ConfirmResolution_Text" Text="保留显示设置？" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}"/>
                </Border>
                <Border CornerRadius="0,0,10,10" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,18">
                    <StackPanel>
                        <TextBlock x:Name="textblock_Overlay_ConfirmResolution_SubText" Text="..." TextWrapping="Wrap" Foreground="{ThemeResource ApplicationDimGrayBrush}"/>
                        <Button x:Name="button_Overlay_ConfirmResolution" Margin="0,15,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_ConfirmResolution_Click" Content="保留设置" Style="{ThemeResource ApplicationButton}"/>
                        <Button x:Name="button_Overlay_RevertResolution" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_RevertResolution_Click" Content="还原设置" Style="{ThemeResource ApplicationButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Overlay - MessageBox -->
        <Grid x:Name="grid_Overlay_MessageBox" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalContentAlignment="Center" Padding="20">
            <StackPanel MinWidth="300" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,12">
                    <TextBlock x:Name="textblock_Overlay_MessageBox_Text" Text="..." TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}"/>
                </Border>
                <Border CornerRadius="0,0,10,10" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,18">
                    <StackPanel>
                        <TextBlock x:Name="textblock_Overlay_MessageBox_SubText" Text="..." TextWrapping="Wrap" LineHeight="22"/>
                        <ListView x:Name="listview_Overlay_MessageBox" MaxHeight="300" Margin="0,10,0,0" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="listview_Overlay_MessageBox_ItemClick" Style="{ThemeResource ApplicationMessageBoxListView}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Overlay - AppPicker -->
        <Grid x:Name="grid_Overlay_AppPicker" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationBlackColor}" Opacity="0.90"/>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalContentAlignment="Center" Padding="20">
            <StackPanel MinWidth="300" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,12">
                    <TextBlock x:Name="textblock_Overlay_AppPicker_Text" Text="添加应用程序" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}"/>
                </Border>
                <Border CornerRadius="0,0,10,10" BorderThickness="1,0,1,1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}" Padding="18,14,18,18">
                    <StackPanel>
                        <ListView x:Name="listview_Overlay_AppPicker" MaxHeight="420" SelectionMode="Multiple" IsItemClickEnabled="True" ItemClick="listview_Overlay_AppPicker_ItemClick" Style="{ThemeResource ApplicationListView}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AppPickerIdl">
                                    <Grid Height="100">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{x:Bind IconPath}" Width="40" Height="40"/>
                                        <StackPanel Grid.Row="1" Margin="0,5,0,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind Detail}" TextWrapping="NoWrap" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource ApplicationDimGrayBrush}" ToolTipService.ToolTip="{x:Bind Detail}"/>
                                            <TextBlock Text="{x:Bind AppName}" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Center" ToolTipService.ToolTip="{x:Bind AppName}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="button_Overlay_AppPicker_Confirm" HorizontalAlignment="Stretch" Click="button_Overlay_AppPicker_Confirm_Click" Content="确认" Style="{ThemeResource ApplicationButton}"/>
                            <Button Grid.Column="1" x:Name="button_Overlay_AppPicker_Cancel" Margin="10,0,0,0" HorizontalAlignment="Stretch" Click="button_Overlay_AppPicker_Cancel_Click" Content="取消" Style="{ThemeResource ApplicationButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Overlay - Notification -->
        <Border x:Name="grid_Overlay_Notification" Margin="0,84,12,0" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{ThemeResource ApplicationAccentDimColor}" Opacity="0.90"/>
            </Border.Background>
            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="textblock_Notification_Text" Text="..." TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{ThemeResource ApplicationWhiteBrush}" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>