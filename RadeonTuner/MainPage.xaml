                                            <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="调整允许的最高显卡频率。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Core_Max_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
                                        <Grid Style="{ThemeResource FlatControl}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Core_Max" Text="{Binding ElementName=slider_Core_Max, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Core_Max" ValueChanged="slider_Core_Max_ValueChanged" Margin="10,0,0,0" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

