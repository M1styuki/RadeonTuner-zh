                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Power_Limit_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
                                        <Grid Style="{ThemeResource FlatControl}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Power_Limit" Text="{Binding ElementName=slider_Power_Limit, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
