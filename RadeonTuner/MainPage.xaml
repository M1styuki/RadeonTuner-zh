                                    <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="关闭应用程序时最小化到系统托盘，而不是退出。"/>
                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_Close_Tray" OnContent="" OffContent="" AutomationProperties.Name="关闭到系统托盘" Toggled="toggleswitch_Close_Tray_Toggled"/>
