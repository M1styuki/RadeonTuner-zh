                                            <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 部分应用程序需要启用“曲面细分”才能使覆盖生效。&#10;&#10;* 曲面细分模式和级别仅适用于 DirectX 11 应用程序。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_TessellationMode_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
