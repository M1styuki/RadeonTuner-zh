                                            <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="调整 GPU 整个频率范围内的电压偏移。较低电压可提升性能。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Power_Voltage_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
