                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="显存时序"/>
                                            <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="调整显存时序配置。更快的显存延迟时序可提升性能。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Memory_Timing_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
                                        <ComboBox x:Name="combobox_Memory_Timing" Margin="0,2,0,0" Width="320" HorizontalAlignment="Left" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Memory_Timing_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Memory ECC / EDC -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="显存 ECC / EDC"/>
                                            <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="调整显存 ECC 模式。纠错码（ECC）可检测数据损坏并尝试纠正。&#10;&#10;* 禁用 ECC 可能略微提升 GPU 性能，但会牺牲稳定性和可靠性。&#10;&#10;* ECC 显存主要用于工作站 GPU。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Memory_Ecc_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
                                        <ComboBox x:Name="combobox_Memory_Ecc" Margin="0,2,0,0" Width="320" HorizontalAlignment="Left" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Memory_Ecc_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Memory Frequency -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="显存最高频率"/>
                                            <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="调整允许的最高显存频率。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Memory_Max_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
