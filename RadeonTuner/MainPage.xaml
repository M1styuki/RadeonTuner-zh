                                        <Button x:Name="button_EnableRadeonServices" Content="启用 Radeon 服务" Click="button_EnableRadeonServices_Click" Margin="8,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="手动启用 AMD External Events Utility 和 AMD Crash Defender Service。" VerticalAlignment="Center" />
