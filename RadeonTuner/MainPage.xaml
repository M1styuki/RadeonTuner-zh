                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_Hide_Tray_Icon" OnContent="" OffContent="" AutomationProperties.Name="隐藏托盘图标" Toggled="toggleswitch_Hide_Tray_Icon_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Theme style -->
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="主题颜色样式"/>
                                        <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="选择应用程序使用的主题颜色样式。"/>
                                    </Grid>
                                    <ComboBox x:Name="combobox_ThemeStyle" Margin="0,2,0,0" Width="320" HorizontalAlignment="Left" SelectionChanged="combobox_ThemeStyle_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                </StackPanel>
                            </Border>

                            <!-- Monochrome icon -->
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="显示单色应用程序图标"/>
                                    <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="将彩色应用程序图标替换为黑白单色版本。"/>
                                    <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 更改此设置需要重启 RadeonTuner 才能生效。"/>
                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_ThemeIconMono" OnContent="" OffContent="" AutomationProperties.Name="显示单色应用程序图标" Toggled="toggleswitch_ThemeIconMono_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Show experimental -->
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="显示实验性设置"/>
                                    <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="显示用于测试目的的实验性设置；其中部分设置使用占位值。"/>
                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_ShowExperimental" OnContent="" OffContent="" AutomationProperties.Name="显示实验性设置" Toggled="toggleswitch_ShowExperimental_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Skip support check -->
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="跳过显卡功能支持检查"/>
                                    <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="RadeonTuner 会向驱动程序确认是否支持某项显卡功能。启用此设置可跳过检查，以便测试不受支持的功能。"/>
                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_SkipSupportCheckGraphics" OnContent="" OffContent="" AutomationProperties.Name="跳过显卡功能支持检查" Toggled="toggleswitch_SkipSupportCheckGraphics_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Radeon services -->
