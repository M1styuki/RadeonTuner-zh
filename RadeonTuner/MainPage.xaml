<Page x:Class="RadeonTuner.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RadeonTuner" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Language="zh-CN" FontFamily="{StaticResource ApplicationFontFamily}" Loaded="page_Loaded" RequestedTheme="Dark" Background="{ThemeResource ApplicationBlackColor}" PointerMoved="PointerMoved_AdjustCursor">
    <Page.Resources>
        <Style x:Key="FlatSettingRow" TargetType="Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="FlatSettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FlatValueLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource ApplicationDimGrayBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FlatValueHint" TargetType="TextBlock" BasedOn="{StaticResource FlatValueLabel}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="FlatHelpIcon" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <Style x:Key="FlatToggleSwitch" TargetType="ToggleSwitch">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-4,-6,-4,-6" />
            <Setter Property="ManipulationMode" Value="System,TranslateX" />
            <Setter Property="IsDoubleTapEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid x:Name="RootGrid" Width="44" Height="32" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OuterBorder.Fill" Value="{ThemeResource ThemeHoverBrush}" />
                                            <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ApplicationDimGrayBrush}" />
                                            <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ThemeNavIndicatorBrush}" />
                                            <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ThemeBorderBrush}" />
                                            <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource ApplicationWhiteBrush}" />
                                            <Setter Target="SwitchKnobOn.Fill" Value="{ThemeResource ApplicationWhiteBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="OuterBorder.Fill" Value="{ThemeResource ThemeHoverBrush}" />
                                            <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ApplicationAccentLightBrush}" />
                                            <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ThemeNavIndicatorBrush}" />
                                            <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ThemeBorderBrush}" />
                                            <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource ApplicationWhiteBrush}" />
                                            <Setter Target="SwitchKnobOn.Fill" Value="{ThemeResource ApplicationWhiteBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ToggleStates"><VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.1" To="Off"><VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut" /></VisualTransition.GeneratedEasingFunction></VisualTransition><VisualTransition GeneratedDuration="0:0:0.1" To="On"><VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut" /></VisualTransition.GeneratedEasingFunction></VisualTransition></VisualStateGroup.Transitions>
                                    <VisualState x:Name="Dragging" />
                                    <VisualState x:Name="Off"><Storyboard><DoubleAnimation Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /><DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /><DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="On"><Storyboard><DoubleAnimation Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /><DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /><DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="SwitchAreaGrid" Background="Transparent" />
                            <Rectangle x:Name="OuterBorder" Width="44" Height="20" VerticalAlignment="Center" RadiusX="10" RadiusY="10" Fill="{ThemeResource ThemeControlBrush}" Stroke="{ThemeResource ThemeBorderBrush}" StrokeThickness="1" />
                            <Rectangle x:Name="SwitchKnobBounds" Width="44" Height="20" VerticalAlignment="Center" RadiusX="10" RadiusY="10" Fill="{ThemeResource ThemeNavIndicatorBrush}" Stroke="{ThemeResource ThemeBorderBrush}" StrokeThickness="1" Opacity="0" />
                            <Grid x:Name="SwitchKnob" Width="24" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" Opacity="0" IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" X="0" />
                                </Grid.RenderTransform>
                            </Grid>
                            <Grid x:Name="SwitchVisualKnob" Width="24" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="VisualKnobTranslateTransform" X="0" />
                                </Grid.RenderTransform>
                                <Ellipse x:Name="SwitchKnobOff" Width="16" Height="16" Fill="{ThemeResource ThemeForegroundBrush}" />
                                <Ellipse x:Name="SwitchKnobOn" Width="16" Height="16" Fill="{ThemeResource ThemeForegroundBrush}" Opacity="0" />
                            </Grid>
                            <ContentPresenter x:Name="HeaderContentPresenter" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="OffContentPresenter" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="OnContentPresenter" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Thumb x:Name="SwitchThumb" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsDoubleTapEnabled="False">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource ApplicationDimGrayBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="FlatMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FlatMetricUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource ApplicationDimGrayBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FanAxisLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource ApplicationDimGrayBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="FanAxisTick" TargetType="TextBlock" BasedOn="{StaticResource FanAxisLabel}">
            <Setter Property="Height" Value="14" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid x:Name="grid_Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Menu -->
            <ListView x:Name="listview_Main" Grid.Column="0" SelectionMode="Single" SelectionChanged="listview_Main_SelectionChanged" Style="{ThemeResource ApplicationNavListView}">
                <ListViewItem x:Name="listviewitem_Tuning">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageTuning}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="调校" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Fans" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageFans}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="风扇" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Graphics" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageGraphics}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="显卡" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Display" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageDisplay}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="显示" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Multimedia" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageMultimedia}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="多媒体" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Settings" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageSettings}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="设置" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Information" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageInformation}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="信息" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Exit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageShutdown}" Width="34" Height="34" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="退出" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border x:Name="border_Header" Grid.Row="0" Margin="14,10,14,0" Padding="0,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="button_Update_Launch" Width="32" Height="32" ToolTipService.ToolTip="有可用更新" Click="button_Update_Launch_Click" Style="{ThemeResource ApplicationButtonImage}" Margin="0" Visibility="Collapsed">
                                <Image Source="{ThemeResource ThemeImageUpdate}" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Column="0" Margin="0,0,10,0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <!-- Gpu Select -->
                                <Button x:Name="button_GpuSelect" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前显卡" Click="button_GpuSelect_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageVideocard}" Width="18" Height="18" />
                                        <TextBlock x:Name="textblock_GpuSelect" Text="选择显卡" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <!-- Display Select -->
                                <Button x:Name="button_DisplaySelect" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前显示器" Click="button_DisplaySelect_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageDisplay}" Width="18" Height="18" />
                                        <TextBlock x:Name="textblock_DisplaySelect" Text="选择显示器" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="stackpanel_AppSelect_Graphics" Orientation="Horizontal">
                                    <!-- Application Select -->
                                    <Button x:Name="button_AppSelect_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Graphics_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="18" Height="18" />
                                            <TextBlock x:Name="textblock_AppSelect_Graphics" Text="选择应用程序" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Application Add -->
                                    <Button x:Name="button_AppAdd_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButtonImage}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Graphics_Click" Width="32" Height="32" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImagePlus}" Width="18" Height="18" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Application Remove -->
                                    <Button x:Name="button_AppRemove_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButtonImage}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Graphics_Click" Width="32" Height="32" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageRemove}" Width="18" Height="18" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="stackpanel_AppSelect_Tuning" Orientation="Horizontal">
                                    <!-- Application Select -->
                                    <Button x:Name="button_AppSelect_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Tuning_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="18" Height="18" />
                                            <TextBlock x:Name="textblock_AppSelect_Tuning" Text="选择应用程序" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Application Add -->
                                    <Button x:Name="button_AppAdd_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButtonImage}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Tuning_Click" Width="32" Height="32" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImagePlus}" Width="18" Height="18" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Application Remove -->
                                    <Button x:Name="button_AppRemove_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButtonImage}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Tuning_Click" Width="32" Height="32" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageRemove}" Width="18" Height="18" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="stackpanel_AppSelect_Display" Orientation="Horizontal">
                                    <!-- Application Select -->
                                    <Button x:Name="button_AppSelect_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Display_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="18" Height="18" />
                                            <TextBlock x:Name="textblock_AppSelect_Display" Text="选择应用程序" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Application Add -->
                                    <Button x:Name="button_AppAdd_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButtonImage}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Display_Click" Width="32" Height="32" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImagePlus}" Width="18" Height="18" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Application Remove -->
                                    <Button x:Name="button_AppRemove_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButtonImage}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Display_Click" Width="32" Height="32" Padding="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageRemove}" Width="18" Height="18" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="stackpanel_AppSelect_Multimedia" Orientation="Horizontal">
                                    <!-- Application Select -->
                                    <Button x:Name="button_AppSelect_Multimedia" IsEnabled="False" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序">
                                        <StackPanel Orientation="Horizontal">
                                            <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="18" Height="18" />
                                            <TextBlock x:Name="textblock_AppSelect_Multimedia" Text="选择应用程序" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- Status -->
                <Border x:Name="border_Gpu_Status" Grid.Row="1" Margin="14,16,14,0" Padding="0" Visibility="Collapsed">
                    <Grid ColumnSpacing="24" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="GPU 负载" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Gpu_Activity" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="核心活动" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="%" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="GPU 频率" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Core_Speed" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="核心频率" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="MHz" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="显存占用" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Memory_Usage" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="显存使用量" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="GB" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="显存频率" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Memory_Speed" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="显存频率" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="MHz" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="显存负载" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Memory_Activity" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="显存活动" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="%" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="GPU 功耗" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Power_Wattage" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="功耗" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="W" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="GPU 电压" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Power_Voltage" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="电压" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="mV" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="GPU 温度" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Temp_Core" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="核心温度" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="°C" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="热点温度" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Temp_Hotspot" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="热点温度" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="°C" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="显存温度" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Temp_Memory" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="显存温度" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="°C" />
                            </StackPanel>
                        </StackPanel>
