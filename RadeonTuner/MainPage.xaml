                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_Shortcut_ContextMenu" OnContent="" OffContent="" AutomationProperties.Name="添加到桌面右键菜单" Toggled="toggleswitch_Shortcut_ContextMenu_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Start window visible -->
