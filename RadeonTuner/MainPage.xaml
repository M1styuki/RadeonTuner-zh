                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="为显示器启用高动态范围，以获得更广的色域并提升画质。"/>
                                        <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置需要支持高动态范围的显示器。&#10;&#10;* 未使用 4:4:4 像素格式时无法启用 HDR。"/>
                                        <ToggleSwitch x:Name="toggleswitch_Display_HdrEnabled" Margin="10,0,0,0" OffContent="高动态范围" OnContent="高动态范围" Toggled="toggleswitch_Display_HdrEnabled_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_HdrEnabled_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="FreeSync 选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- FreeSync Mode -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="AMD FreeSync 技术可在游戏和视频播放期间减少或消除视觉伪影、输入延迟、画面撕裂和卡顿。&#10;&#10;- 可变：将 FreeSync 刷新率动态调整为全屏应用程序的帧率。&#10;&#10;- 静态：将 FreeSync 刷新率调整为设定的显示器刷新率。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置需要支持 AMD FreeSync 的显示器和显卡。&#10;&#10;* 根据应用程序，此设置可能仅在全屏模式下有效。&#10;&#10;* 此设置仅适用于未被列入黑名单的应用程序；部分应用程序（如网页浏览器和视频播放器）可能被禁止使用 FreeSync。"/>
                                            <TextBlock Text="AMD FreeSync / VRR / 自适应同步" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_FreeSyncMode_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
