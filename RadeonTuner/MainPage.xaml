                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Display -->
                        <Grid x:Name="stackpanel_Display" Visibility="Collapsed">
                            <!-- Settings -->
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="显示选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                    <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Background="{ThemeResource ThemeBackgroundBrush}">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Image x:Name="image_Display_Used" Source="{ThemeResource ThemeImageCheckmark}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="当前正在使用此应用程序配置。"/>
                                            <Image Source="/Assets/WarningOrange.png" Margin="5,0,5,0" Width="24" Height="24" ToolTipService.ToolTip="* 显示应用程序配置仅在 RadeonTuner 运行时自动应用。&#10;&#10;* 启动应用程序后，可能需要几秒钟才会应用应用程序配置。&#10;&#10;* 部分设置（如显示、HDR、缩放、电源、格式和覆盖选项）在应用程序配置中不可用。"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Display Resolution -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="显示分辨率" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_Resolution_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_Resolution" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_Resolution_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:DisplayDetailsIdl">
                                                    <TextBlock Text="{x:Bind Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Display Refresh Rate -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="显示刷新率" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_RefreshRate_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_RefreshRate" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_RefreshRate_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:DisplayDetailsIdl">
                                                    <TextBlock Text="{x:Bind Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
