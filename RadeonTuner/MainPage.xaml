                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="风扇转速比例（%）" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Fan_Speed_Percentage" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="风扇转速百分比" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="%" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="1">
                            <TextBlock Style="{ThemeResource FlatMetricLabel}" Text="进风温度" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="textblock_Current_Temp_Intake" Style="{ThemeResource FlatMetricValue}" Text="—" ToolTipService.ToolTip="进风温度" />
                                <TextBlock Style="{ThemeResource FlatMetricUnit}" Text="°C" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Buttons -->
                <Border x:Name="border_ActionButtons" Grid.Row="2" Margin="14,4,14,0" Padding="0,4" Visibility="Collapsed">
                    <Grid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Tuning_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Tuning_Apply" Click="button_Tuning_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用调校与风扇设置。&#xA;&#xA;* 绿色：设置未更改。&#xA;* 橙色：设置已更改，请应用。&#xA;* 红色：设置应用失败。" />
                            <Button x:Name="button_Tuning_Reset" Click="button_Tuning_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将调校与风扇设置恢复为默认值。" />
                            <Button x:Name="button_Tuning_Import" Click="button_Tuning_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入调校与风扇设置；导入后不会自动应用。" />
                            <Button x:Name="button_Tuning_Export" Click="button_Tuning_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前调校与风扇设置导出到文件。" />
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Fan_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Fan_Apply" Click="button_Tuning_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用调校与风扇设置。&#xA;&#xA;* 绿色：设置未更改。&#xA;* 橙色：设置已更改，请应用。&#xA;* 红色：设置应用失败。" />
                            <Button x:Name="button_Fan_Reset" Click="button_Tuning_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将调校与风扇设置恢复为默认值。" />
                            <Button x:Name="button_Fan_Import" Click="button_Tuning_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入调校与风扇设置；导入后不会自动应用。" />
                            <Button x:Name="button_Fan_Export" Click="button_Tuning_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前调校与风扇设置导出到文件。" />
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Graphics_Buttons" ItemWidth="125" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Graphics_Apply" Click="button_Graphics_Apply_Click" Content="应用" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用显卡设置。&#xA;&#xA;* 绿色：设置未更改。&#xA;* 橙色：设置已更改，请应用。&#xA;* 红色：设置应用失败。" />
                            <Button x:Name="button_Graphics_Reset" Click="button_Graphics_Reset_Click" Content="重置" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将显卡设置恢复为默认值。" />
                            <Button x:Name="button_Graphics_Import" Click="button_Graphics_Import_Click" Content="导入" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入显卡设置。" />
                            <Button x:Name="button_Graphics_Export" Click="button_Graphics_Export_Click" Content="导出" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前显卡设置导出到文件。" />
                            <Button x:Name="button_Graphics_Clear_ShaderCache" Click="button_Graphics_Clear_ShaderCache_Click" Content="清除着色器" Width="120" ToolTipService.ToolTip="清除基于磁盘的着色器缓存内容。" Style="{ThemeResource ApplicationButton}" />
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Display_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Display_Apply" Click="button_Display_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用显示设置。&#xA;&#xA;* 绿色：设置未更改。&#xA;* 橙色：设置已更改，请应用。&#xA;* 红色：设置应用失败。" />
                            <Button x:Name="button_Display_Reset" Click="button_Display_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将显示设置恢复为默认值。" />
                            <Button x:Name="button_Display_Import" Click="button_Display_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入显示设置。" />
                            <Button x:Name="button_Display_Export" Click="button_Display_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前显示设置导出到文件。" />
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Multimedia_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Multimedia_Apply" Click="button_Multimedia_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用多媒体设置。&#xA;&#xA;* 绿色：设置未更改。&#xA;* 橙色：设置已更改，请应用。&#xA;* 红色：设置应用失败。" />
                            <Button x:Name="button_Multimedia_Reset" Click="button_Multimedia_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将多媒体设置恢复为默认值。" />
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Information_Buttons" ItemWidth="155" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Website_Project" Content="访问项目网站" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Website_Project_Click" />
                            <Button x:Name="button_Website_Donation" Content="打开捐赠页面" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Website_Donation_Click" />
                            <Button x:Name="button_Fps_Overlayer" Content="获取 FpsOverlayer" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Fps_Overlayer_Click" />
                            <Button x:Name="button_Check_Update" Content="检查更新" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Update_Check_Click" />
                        </VariableSizedWrapGrid>
                    </Grid>
                </Border>
                <!-- Main -->
                <ScrollViewer Grid.Row="3" Margin="14,8,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,24,18">
                        <!-- Graphics -->
                        <Grid x:Name="stackpanel_Graphics" Visibility="Collapsed">
                            <StackPanel x:Name="stackpanel_Graphics_Rows">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>
                                <!-- FSR Latency Reduction -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 延迟降低（Anti-Lag）" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="232" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="FSR 延迟降低（Anti-Lag）通过控制 CPU 工作节奏，避免其过度领先 GPU，从而帮助减少 GPU 受限场景中的输入延迟；启用此设置可能导致轻微帧率下降。" Margin="2,0" />
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置不适用于 OpenGL 应用程序。&#xA;&#xA;* 启用“Radeon Chill”时无法使用此设置。&#xA;&#xA;* 更改显卡设置可能需要重启应用程序才能生效。&#xA;&#xA;* 由于驱动程序限制，应用程序配置中的显卡设置会在各块显卡之间共享。&#xA;&#xA;* 部分设置（如“流体运动帧”和“超分辨率”）在最小或仅驱动程序安装类型下不可用。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" x:Name="image_FsrLatencyReduction_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" ToolTipService.ToolTip="..." />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{ThemeResource FlatValueHint}" x:Name="textblock_FsrLatencyReduction_Value" ToolTipService.ToolTip="驱动中的当前设置" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                        </StackPanel>
                                        <ToggleSwitch Loaded="toggle_Loaded" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_FsrLatencyReduction" OnContent="" OffContent="" AutomationProperties.Name="FSR 延迟降低（Anti-Lag）" Toggled="toggleswitch_FsrLatencyReduction_Toggled" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1" Width="44" Height="32" MinWidth="0" Padding="0" />
                                    </Grid>
                                </Border>
                                <!-- FSR Multi Frame Generation Ratio -->
                                <Border Style="{ThemeResource FlatSettingRow}" x:Name="stackpanel_FsrMultiFrameGenerationRatio">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 多帧生成倍率" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="232" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="选择 FSR 多帧生成使用的帧率倍率。倍率越高，画面越流畅，但可能因游戏内运动强度而出现更多图形异常。" Margin="2,0" />
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置仅适用于 RDNA4 或更新显卡。&#xA;&#xA;* 此设置仅适用于白名单应用程序。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageExperimental}" ToolTipService.ToolTip="这是用于测试目的的实验性设置。" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{ThemeResource FlatValueHint}" x:Name="textblock_FsrMultiFrameGenerationRatio_Value" ToolTipService.ToolTip="驱动中的当前设置" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_FsrMultiFrameGenerationRatio" Margin="0" Width="160" HorizontalAlignment="Right" SelectionChanged="combobox_FsrMultiFrameGenerationRatio_SelectionChanged" Style="{ThemeResource ApplicationComboBox}" MinWidth="160" VerticalAlignment="Center" Grid.Column="1" Height="32" />
                                    </Grid>
                                </Border>
                                <!-- FSR Show information in-game -->
                                <Border Style="{ThemeResource FlatSettingRow}" x:Name="stackpanel_FsrShowInformation">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 显示调试信息" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="232" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="在运行中的应用程序内显示 FSR 版本号等调试（水印）信息。" Margin="2,0" />
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置仅在应用程序使用 FSR 3.1.5 或更新版本时有效。&#xA;&#xA;* 如果禁用后信息仍未消失，可尝试重启电脑。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageExperimental}" ToolTipService.ToolTip="这是用于测试目的的实验性设置。" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{ThemeResource FlatValueHint}" x:Name="textblock_FsrShowInformation_Value" ToolTipService.ToolTip="驱动中的当前设置" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                        </StackPanel>
                                        <ToggleSwitch Loaded="toggle_Loaded" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_FsrShowInformation" OnContent="" OffContent="" AutomationProperties.Name="FSR 显示调试信息" Toggled="toggleswitch_FsrShowInformation_Toggled" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1" Width="44" Height="32" MinWidth="0" Padding="0" />
                                    </Grid>
                                </Border>
                                <!-- FSR Disable ML Swapchain -->
                                <Border Style="{ThemeResource FlatSettingRow}" x:Name="stackpanel_FsrDisableMLSwapchain">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 禁用 ML 交换链" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="252" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="禁用 FSR 功能使用的机器学习交换链；此设置也称为硬件翻转计量（Hardware Flip Metering），可均匀分配帧以提升流畅度并减少卡顿。&#xA;&#xA;* 禁用机器学习交换链可能降低性能和流畅度。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageExperimental}" ToolTipService.ToolTip="这是用于测试目的的实验性设置。" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{ThemeResource FlatValueHint}" x:Name="textblock_FsrDisableMLSwapchain_Value" ToolTipService.ToolTip="驱动中的当前设置" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                        </StackPanel>
                                        <ToggleSwitch Loaded="toggle_Loaded" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_FsrDisableMLSwapchain" OnContent="" OffContent="" AutomationProperties.Name="FSR 禁用 ML 交换链" Toggled="toggleswitch_FsrDisableMLSwapchain_Toggled" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1" Width="44" Height="32" MinWidth="0" Padding="0" />
                                    </Grid>
                                </Border>
                                <!-- FSR Upscaling Override -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 超分辨率覆盖" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="232" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="使用驱动程序提供的最新版本覆盖应用程序的 FSR 功能，例如允许驱动程序将 FSR3 升级到 FSR4 或更新版本。" Margin="2,0" />
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置仅适用于 RDNA3 或更新显卡，并且要求应用程序至少支持 FSR 3.1.0 并使用外部 FSR DLL 文件。&#xA;&#xA;* 部分应用程序会在设置菜单中使用预设的 FSR 版本号文本，因此即使 FSR 覆盖已启用并正常工作，你仍可能看到旧版本号文本。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" x:Name="image_FsrOverrideUpscaling_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" ToolTipService.ToolTip="..." />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{ThemeResource FlatValueHint}" x:Name="textblock_FsrOverrideUpscaling_Value" ToolTipService.ToolTip="驱动中的当前设置" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                        </StackPanel>
                                        <ToggleSwitch Loaded="toggle_Loaded" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_FsrOverrideUpscaling" OnContent="" OffContent="" AutomationProperties.Name="FSR 超分辨率覆盖" Toggled="toggleswitch_FsrOverrideUpscaling_Toggled" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1" Width="44" Height="32" MinWidth="0" Padding="0" />
                                    </Grid>
                                </Border>
                                <!-- FSR Frame Generation Override -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 帧生成覆盖" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="232" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="使用驱动程序提供的最新版本覆盖应用程序的 FSR 功能，例如允许驱动程序将 FSR3 升级到 FSR4 或更新版本。" Margin="2,0" />
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置仅适用于 RDNA4 或更新显卡，并且要求应用程序至少支持 FSR 3.1.4 并使用外部 FSR DLL 文件。&#xA;&#xA;* 部分应用程序会在设置菜单中使用预设的 FSR 版本号文本，因此即使 FSR 覆盖已启用并正常工作，你仍可能看到旧版本号文本。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" x:Name="image_FsrOverrideFrameGeneration_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" ToolTipService.ToolTip="..." />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{ThemeResource FlatValueHint}" x:Name="textblock_FsrOverrideFrameGeneration_Value" ToolTipService.ToolTip="驱动中的当前设置" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                        </StackPanel>
                                        <ToggleSwitch Loaded="toggle_Loaded" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_FsrOverrideFrameGeneration" OnContent="" OffContent="" AutomationProperties.Name="FSR 帧生成覆盖" Toggled="toggleswitch_FsrOverrideFrameGeneration_Toggled" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1" Width="44" Height="32" MinWidth="0" Padding="0" />
                                    </Grid>
                                </Border>
                                <!-- FSR Multi Frame Generation Override -->
                                <Border Style="{ThemeResource FlatSettingRow}" x:Name="stackpanel_FsrOverrideMultiFrameGeneration">
                                    <Grid MinWidth="0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" MinWidth="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{ThemeResource FlatSettingLabel}" Text="FSR 多帧生成覆盖" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="212" />
                                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0" Orientation="Horizontal">
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="使用驱动程序提供的最新版本覆盖应用程序的 FSR 功能，例如允许驱动程序将 FSR3 升级到 FSR4 或更新版本。" Margin="2,0" />
                                                    <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置仅适用于 RDNA4 或更新显卡，并且要求应用程序至少支持 FSR 3.1.6 并使用外部 FSR DLL 文件。&#xA;&#xA;* 部分应用程序会在设置菜单中使用预设的 FSR 版本号文本，因此即使 FSR 覆盖已启用并正常工作，你仍可能看到旧版本号文本。" Margin="2,0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                                        <Image Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageExperimental}" ToolTipService.ToolTip="这是用于测试目的的实验性设置。" />
                                                        <Image Style="{ThemeResource FlatHelpIcon}" x:Name="image_FsrOverrideMultiFrameGeneration_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" ToolTipService.ToolTip="..." />
                                                    </StackPanel>
