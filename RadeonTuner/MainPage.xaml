                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="帧率目标控制设置用户定义的目标最大帧率，以降低功耗。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅在使用独占全屏模式时有效。&#10;&#10;* 驱动程序缺陷可能导致此 GPU 上设置的 FRTC 值也被应用到其他 GPU。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Frtc" Margin="10,0,0,0" OffContent="帧率目标控制" OnContent="帧率目标控制" Toggled="toggleswitch_Frtc_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Frtc_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="最大 FPS" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Frtc_FrameRateTarget_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Frtc_Fps" Text="{Binding ElementName=slider_Frtc_FrameRateTarget, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Frtc_FrameRateTarget" Margin="10,0,0,0" ValueChanged="slider_Frtc_FrameRateTarget_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Radeon Boost -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="通过动态调整分辨率，在尽量不影响画质的情况下提升受支持游戏的性能。&#10;&#10;Radeon Boost 算法可配置为监测游戏场景细节和/或用户输入。&#10;&#10;- 基于输入：主要根据鼠标或控制器输入调整外围区域分辨率，在快速移动时降低延迟并提升性能。&#10;&#10;- 基于场景：分析游戏画面，仅在低细节区域降低分辨率，在提升性能的同时保留关键区域的画质。&#10;&#10;- 多模式：结合基于场景和基于输入的分析，在瞄准或移动时进一步提升性能并降低延迟。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅适用于白名单应用程序；如需绕过驱动程序限制，可将应用程序可执行文件重命名为“sottr.exe”。&#10;&#10;* 启用“Radeon Chill”时无法使用此设置。&#10;&#10;* 此设置仅适用于 RDNA2 或更新显卡。"/>
                                            <Image x:Name="image_RadeonBoost_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                            <TextBlock Margin="10,0,0,0" Text="Radeon Boost 2" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonBoost_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_RadeonBoost" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_RadeonBoost_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="最低分辨率" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonBoost_MinResolution_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_RadeonBoost_MinRes" Text="{Binding ElementName=slider_RadeonBoost_MinResolution, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_RadeonBoost_MinResolution" Margin="10,0,0,0" ValueChanged="slider_RadeonBoost_MinResolution_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="锐化选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Radeon Image Sharpening 1 -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="Radeon 图像锐化可恢复被其他效果柔化的游戏画面清晰度，适用于生产力和媒体类应用程序。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置不适用于启用 HDR 的场景和 OpenGL 应用程序。&#10;&#10;* 此设置仅在使用全屏模式时有效。&#10;&#10;* 在应用程序配置中，此设置仅适用于 RDNA 或更新显卡。&#10;&#10;* DirectX 9 应用程序仅在 RDNA 或更新显卡上受支持。"/>
                                            <Image x:Name="image_RadeonImageSharpening1_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                            <ToggleSwitch x:Name="toggleswitch_RadeonImageSharpening1" Margin="10,0,0,0" OffContent="Radeon 图像锐化 1" OnContent="Radeon 图像锐化 1" Toggled="toggleswitch_RadeonImageSharpening1_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening1_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Radeon Image Sharpening 1 Sharpening -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="锐化程度" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening1_Sharpening_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_RadeonImageSharpening1_Sharpening" Text="{Binding ElementName=slider_RadeonImageSharpening1_Sharpening, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_RadeonImageSharpening1_Sharpening" Margin="10,0,0,0" ValueChanged="slider_RadeonImageSharpening1_Sharpening_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Radeon Image Sharpening 2 -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="Radeon 图像锐化可恢复被其他效果柔化的游戏画面清晰度，适用于生产力和媒体类应用程序。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅适用于 RDNA4 或更新显卡。&#10;&#10;* 此设置仅在使用全屏模式时有效，除非同时启用“桌面锐化”选项。"/>
                                            <Image x:Name="image_RadeonImageSharpening2_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                            <ToggleSwitch x:Name="toggleswitch_RadeonImageSharpening2" Margin="10,0,0,0" OffContent="Radeon 图像锐化 2" OnContent="Radeon 图像锐化 2" Toggled="toggleswitch_RadeonImageSharpening2_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening2_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Radeon Image Sharpening 2 Desktop -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="对桌面和应用程序（包括窗口化应用程序）应用锐化。"/>
                                            <ToggleSwitch x:Name="toggleswitch_RadeonImageSharpening2_Desktop" Margin="10,0,0,0" OffContent="桌面锐化" OnContent="桌面锐化" Toggled="toggleswitch_RadeonImageSharpening2_Desktop_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening2_Desktop_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Radeon Image Sharpening 2 Sharpening -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="锐化程度" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonImageSharpening2_Sharpening_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_RadeonImageSharpening2_Sharpening" Text="{Binding ElementName=slider_RadeonImageSharpening2_Sharpening, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_RadeonImageSharpening2_Sharpening" Margin="10,0,0,0" ValueChanged="slider_RadeonImageSharpening2_Sharpening_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="垂直刷新选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Vertical Sync -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="垂直同步将新动画帧的切换与显示刷新同步，使帧间不会出现撕裂。&#10;&#10;* 将帧率限制为显示器刷新率。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 根据渲染管线，此设置可能仅在使用独占全屏模式时有效。"/>
                                            <TextBlock Margin="10,0,0,0" Text="垂直同步" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_VerticalSync_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_VerticalSync" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_VerticalSync_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Radeon Enhanced Sync -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="Radeon 增强同步以低延迟将新动画帧的切换与显示器刷新率同步，使帧间撕裂降至最低。&#10;&#10;* 不会将帧率限制为显示器刷新率。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 根据渲染管线，此设置可能仅在使用独占全屏模式时有效。&#10;&#10;* 当应用程序不支持“增强同步”时，将回退使用“垂直同步”设置。"/>
                                            <ToggleSwitch x:Name="toggleswitch_RadeonEnhancedSync" Margin="10,0,0,0" OffContent="Radeon 增强同步" OnContent="Radeon 增强同步" Toggled="toggleswitch_RadeonEnhancedSync_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_RadeonEnhancedSync_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- OpenGL Triple Buffering -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="专用于 OpenGL 应用程序的替代垂直刷新模式。&#10;&#10;* 不会将帧率限制为显示器刷新率。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 根据渲染管线，此设置可能仅在使用独占全屏模式时有效。"/>
                                            <ToggleSwitch x:Name="toggleswitch_OpenGLTripleBuffering" Margin="10,0,0,0" OffContent="OpenGL 三重缓冲" OnContent="OpenGL 三重缓冲" Toggled="toggleswitch_OpenGLTripleBuffering_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_OpenGLTripleBuffering_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="抗锯齿选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- Anti-Aliasing Override -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="抗锯齿通过平滑锯齿边缘来提升画质，但会消耗一定性能和显存。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 抗锯齿覆盖、方法、级别和 EQAA 仅适用于 DirectX 9（及更旧版本）和部分 OpenGL 应用程序。"/>
                                            <ToggleSwitch x:Name="toggleswitch_AntiAliasingOverride" Margin="10,0,0,0" OffContent="抗锯齿覆盖" OnContent="抗锯齿覆盖" Toggled="toggleswitch_AntiAliasingOverride_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingOverride_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Anti-Aliasing Method -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="选择用于平滑物体边缘的方法。采样越多，画质越好，但性能越低。&#10;&#10;* 多重采样（MSAA）仅处理物体边缘。&#10;&#10;* 自适应多重采样（Adaptive MSAA）同时平滑边缘和透明纹理。&#10;&#10;* 超级采样（SSAA/FSAA）覆盖每个像素，画质出色，但性能开销较大。"/>
                                            <TextBlock Text="抗锯齿方法" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingMethod_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_AntiAliasingMethod" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_AntiAliasingMethod_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Anti-Aliasing Level -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="选择用于边缘抗锯齿的采样数。采样数越高，画质越好，但性能越低。"/>
                                            <TextBlock Text="抗锯齿级别" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingLevel_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_AntiAliasingLevel" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_AntiAliasingLevel_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Enhanced Quality Anti-Aliasing -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="增强质量抗锯齿（EQAA）是一种抗锯齿技术，无需额外显存即可提供更高级的锯齿边缘平滑效果，但会带来少量额外性能开销。"/>
                                            <ToggleSwitch x:Name="toggleswitch_AntiAliasingEnhancedQuality" Margin="10,0,0,0" OffContent="增强质量抗锯齿" OnContent="增强质量抗锯齿" Toggled="toggleswitch_AntiAliasingEnhancedQuality_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_AntiAliasingEnhancedQuality_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Morphological Anti-Aliasing -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="形态抗锯齿（MLAA）是一种性能开销极低的边缘平滑技术。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅在使用独占全屏模式时有效。&#10;&#10;* 此设置仅适用于 DirectX 9 应用程序。"/>
                                            <ToggleSwitch x:Name="toggleswitch_MorphologicalAntiAliasing" Margin="10,0,0,0" OffContent="形态抗锯齿" OnContent="形态抗锯齿" Toggled="toggleswitch_MorphologicalAntiAliasing_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_MorphologicalAntiAliasing_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="纹理选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <!-- Anisotropic Texture Filtering Override -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="各向异性过滤可提升大多数 3D 应用程序中远处或倾斜表面（如道路和树木）的纹理质量，但会消耗一定帧率性能。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 部分应用程序需要将纹理过滤类型设置为“三线性”或“双线性”才能使覆盖生效。&#10;&#10;* 此设置不适用于 DirectX 12 和 Vulkan 应用程序。"/>
                                            <TextBlock Text="各向异性纹理过滤覆盖" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_AnisotropicTextureFiltering_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_AnisotropicTextureFiltering" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_AnisotropicTextureFiltering_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Texture Filtering Quality -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="控制纹理过滤的优化侧重。“标准”通常是画质与性能的最佳平衡。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 需要在应用程序中启用“各向异性”等纹理过滤类型才能生效。&#10;&#10;* 此设置不适用于 DirectX 12 和 Vulkan 应用程序。"/>
                                            <TextBlock Text="纹理过滤质量" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_TextureFilteringQuality_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_TextureFilteringQuality" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_TextureFilteringQuality_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Surface Format Optimization -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="允许驱动程序覆盖应用程序并选择更优的纹理格式，以提升性能并降低显存占用，通常对画质影响很小。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置不适用于 DirectX 12 和 Vulkan 应用程序。"/>
                                            <ToggleSwitch x:Name="toggleswitch_SurfaceFormatOptimization" Margin="10,0,0,0" OffContent="表面格式优化" OnContent="表面格式优化" Toggled="toggleswitch_SurfaceFormatOptimization_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_SurfaceFormatOptimization_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- OpenGL 10-Bit Pixel Format -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="为兼容的显示器和应用程序启用 10 位 OpenGL 纹理支持。"/>
                                        <Image Source="/Assets/WarningRed.png" Width="24" Height="24" ToolTipService.ToolTip="* 启用此设置会破坏 HDR 兼容性。&#10;&#10;* 需要重启系统才能生效。"/>
                                        <ToggleSwitch x:Name="toggleswitch_OpenGL10BitPixelFormat" Margin="10,0,0,0" OffContent="OpenGL 10 位像素格式" OnContent="OpenGL 10 位像素格式" Toggled="toggleswitch_OpenGL10BitPixelFormat_Toggled"/>
                                        <TextBlock Margin="5,0,0,0" x:Name="textblock_OpenGL10BitPixelFormat_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="曲面细分选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <!-- Tessellation Mode -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="曲面细分可调整用于渲染物体的多边形数量，以增强细节，但会消耗一定帧率性能。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 部分应用程序需要启用“曲面细分”才能使覆盖生效。&#10;&#10;* 曲面细分模式和级别仅适用于 DirectX 11 应用程序。"/>
                                            <TextBlock Text="曲面细分模式" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_TessellationMode_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Tessellation_Mode" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Tessellation_Mode_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <!-- Tessellation Level -->
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="选择物体曲面细分时生成的多边形数量。设置上限可避免过度细分，因为过度细分对画质和性能几乎没有益处。"/>
                                            <TextBlock Text="曲面细分级别" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_TessellationLevel_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Tessellation_Level" Margin="0,5,0,0" Width="300" SelectionChanged="combobox_Tessellation_Level_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Access Overlay -->
                            <Grid x:Name="stackpanel_Graphics_AccessOverlay" CornerRadius="8" Visibility="Collapsed">
                                <Grid.Background>
                                    <SolidColorBrush Color="{ThemeResource ThemeBackgroundDarkColor}" Opacity="0.90"/>
                                </Grid.Background>

                                <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="无法访问所选显卡，&#10;请重新选择显卡……" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Tuning -->
                        <Grid x:Name="stackpanel_Tuning" Visibility="Collapsed">
                            <!-- Settings -->
                            <StackPanel>
                                <!-- Keep Active -->
                                <Border Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="当 GPU 驱动程序因意外系统故障或其他原因将配置中的调校与风扇设置重置为默认值时，自动重新应用这些设置。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 启用“保持生效”前，请确保使用稳定且经过充分测试的调校与风扇设置。&#10;&#10;* 此设置仅在 RadeonTuner 运行时有效。"/>
                                            <ToggleSwitch x:Name="toggleswitch_KeepActive" Width="130" Margin="10,0,0,0" OffContent="保持生效" OnContent="保持生效" Toggled="toggleswitch_KeepActive_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_KeepActive_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Image x:Name="image_Tuning_Used" Source="{ThemeResource ThemeImageCheckmark}" Width="24" Height="24" ToolTipService.ToolTip="当前正在使用此应用程序配置。"/>
                                            <Image Source="/Assets/WarningOrange.png" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="* 调校应用程序配置仅在 RadeonTuner 运行时自动应用。&#10;&#10;* 启动应用程序后，可能需要几秒钟才会应用应用程序配置。"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- GPU Tuning -->
                                <TextBlock Text="GPU 调校" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整最低显卡频率。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 将最低频率设置得接近最高频率可能导致性能大幅下降；请通过测试性能找到最佳平衡点，或保留默认值。"/>
                                            <TextBlock Margin="10,0,0,0" Text="最低频率" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Core_Min_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Core_Min" Text="{Binding ElementName=slider_Core_Min, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Core_Min" ValueChanged="slider_Core_Min_ValueChanged" Margin="10,0,0,0" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整允许的最高显卡频率。"/>
                                            <TextBlock x:Name="textblock_Core_Max" Margin="10,0,0,0" Text="最高频率" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Core_Max_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Core_Max" Text="{Binding ElementName=slider_Core_Max, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Core_Max" ValueChanged="slider_Core_Max_ValueChanged" Margin="10,0,0,0" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Memory Tuning -->
                                <TextBlock Text="显存调校" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整显存时序配置。更快的显存延迟时序可提升性能。"/>
                                            <TextBlock Margin="10,0,0,0" Text="显存时序" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Memory_Timing_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Memory_Timing" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Memory_Timing_SelectionChanged"/>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整显存 ECC 模式。纠错码（ECC）可检测数据损坏并尝试纠正。&#10;&#10;* 禁用 ECC 可能略微提升 GPU 性能，但会牺牲稳定性和可靠性。&#10;&#10;* ECC 显存主要用于工作站 GPU。"/>
                                            <TextBlock Margin="10,0,0,0" Text="显存 ECC / EDC" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Memory_Ecc_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Memory_Ecc" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Memory_Ecc_SelectionChanged"/>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整允许的最高显存频率。"/>
                                            <TextBlock Margin="10,0,0,0" Text="最高频率" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Memory_Max_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Memory_Max" Text="{Binding ElementName=slider_Memory_Max, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Memory_Max" Margin="10,0,0,0" ValueChanged="slider_Memory_Max_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Power Tuning -->
                                <TextBlock Text="功耗调校" Margin="0,10,0,0" Style="{ThemeResource ApplicationSectionHeader}"/>
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整 GPU 允许的最高功耗。功耗上限越高，性能越强。"/>
                                            <TextBlock Margin="10,0,0,0" Text="功耗上限" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Power_Limit_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Power_Limit" Text="{Binding ElementName=slider_Power_Limit, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Power_Limit" Margin="10,0,0,0" ValueChanged="slider_Power_Limit_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整 GPU 整个频率范围内的电压偏移。较低电压可提升性能。"/>
                                            <TextBlock x:Name="textblock_Power_Voltage" Margin="10,0,0,0" Text="电压" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Power_Voltage_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Power_Voltage" Text="{Binding ElementName=slider_Power_Voltage, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Power_Voltage" Margin="10,0,0,0" ValueChanged="slider_Power_Voltage_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="调整 GPU 的热设计电流（TDC）上限。TDC 上限越高，性能越强。"/>
                                            <TextBlock Margin="10,0,0,0" Text="TDC 上限" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Power_TDC_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="textbox_Power_TDC" Text="{Binding ElementName=slider_Power_TDC, Path=Value}" Style="{ThemeResource ApplicationTextBoxNoHit}"/>
                                            <Slider Grid.Column="1" x:Name="slider_Power_TDC" Margin="10,0,0,0" ValueChanged="slider_Power_TDC_ValueChanged" Style="{ThemeResource ApplicationSlider}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Access Overlay -->
                            <Grid x:Name="stackpanel_Tuning_AccessOverlay" CornerRadius="8" Visibility="Collapsed">
                                <Grid.Background>
                                    <SolidColorBrush Color="{ThemeResource ThemeBackgroundDarkColor}" Opacity="0.90"/>
                                </Grid.Background>

                                <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <TextBlock Text="无法访问所选显卡，&#10;请重新选择显卡……" TextWrapping="Wrap" Style="{ThemeResource ApplicationOverlayTitle}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Fans -->
                        <Grid x:Name="stackpanel_Fans" Visibility="Collapsed">
                            <!-- Settings -->
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="风扇转速与温度选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                    <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Background="{ThemeResource ThemeBackgroundBrush}">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Image x:Name="image_Fans_Used" Source="{ThemeResource ThemeImageCheckmark}" Margin="5,0,0,0" Width="24" Height="24" ToolTipService.ToolTip="当前正在使用此应用程序配置。"/>
                                            <Image Source="/Assets/WarningOrange.png" Margin="5,0,5,0" Width="24" Height="24" ToolTipService.ToolTip="* 调校应用程序配置仅在 RadeonTuner 运行时自动应用。&#10;&#10;* 启动应用程序后，可能需要几秒钟才会应用应用程序配置。"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="让驱动程序控制 GPU 风扇，以便设置自定义风扇曲线；禁用后，GPU 将按 BIOS 中的设置管理风扇。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Fan_Control" Width="128" Margin="10,0,0,0" OffContent="风扇控制" OnContent="风扇控制" Toggled="toggleswitch_Fan_Control_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Control_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="当 GPU 无需散热时关闭风扇，以降低噪音并延长风扇寿命。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Fan_Zero_Rpm" Width="185" Margin="10,0,0,0" OffContent="风扇零 RPM 模式" OnContent="风扇零 RPM 模式" Toggled="toggleswitch_Fan_Zero_Rpm_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Zero_Rpm_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="grid_Fan_Graph" Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Column="0" Grid.Row="0" BorderBrush="{ThemeResource ThemeForegroundBrush}" BorderThickness="2" CornerRadius="6">
                                            <Grid>
                                                <Border x:Name="border_Fan_Zero_Rpm_Range" Width="0" Opacity="0.40" Background="{ThemeResource ApplicationDimGrayColor}" HorizontalAlignment="Left" ToolTipService.ToolTip="风扇零 RPM 范围：处于此范围内且显卡温度足够低时，风扇将关闭。"/>
                                                <Grid Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Line Margin="0,25,0,0" X1="500" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                                    <Line Margin="0,50,0,0" X1="500" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                                    <Line Margin="0,75,0,0" X1="500" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                                    <Line Margin="125,0,0,0" Y1="100" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                                    <Line Margin="250,0,0,0" Y1="100" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                                    <Line Margin="375,0,0,0" Y1="100" Opacity="0.20" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="1"/>
                                                    <Line x:Name="grid_Fan_Zero_Rpm_Line_Gpu" Visibility="Collapsed" Margin="275,0,0,0" Y1="99" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeDashArray="3" StrokeDashCap="Round" StrokeThickness="3" ToolTipService.ToolTip="风扇零 RPM 温度（当前设置为）"/>
                                                    <Line x:Name="grid_Fan_Zero_Rpm_Line_Profile" Visibility="Collapsed" Margin="275,0,0,0" Y1="99" Stroke="{ThemeResource SystemAccentColor}" StrokeDashArray="3" StrokeDashCap="Round" StrokeThickness="3" ToolTipService.ToolTip="风扇零 RPM 温度（配置目标）"/>
                                                    <Polyline x:Name="polyline_Fan_Lines_Gpu" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" Stroke="{ThemeResource ApplicationDimGrayColor}" StrokeThickness="2" ToolTipService.ToolTip="驱动中的当前设置"/>
                                                    <Polyline x:Name="polyline_Fan_Lines_Profile" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" Stroke="{ThemeResource SystemAccentColor}" StrokeThickness="2" ToolTipService.ToolTip="配置目标"/>
                                                </Grid>
                                                <Grid>
                                                    <Ellipse x:Name="ellipse_Fan_Point_0" Margin="0,50,0,0" Width="10" Height="10" Fill="{ThemeResource ThemeForegroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTipService.ToolTip="风扇曲线 1"/>
