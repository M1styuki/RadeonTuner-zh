                                    <Button x:Name="button_Eyefinity_Overlay_Enable" Content="启用 Eyefinity" Click="button_Eyefinity_Enable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 未激活时启用它。" />
                                    <Button x:Name="button_Eyefinity_Overlay_Disable" Content="禁用 Eyefinity" Click="button_Eyefinity_Disable_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="在 Eyefinity 已激活时禁用它。" />
                                    <Button x:Name="button_Eyefinity_Overlay_Close" Content="关闭" Click="button_Eyefinity_Manage_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="关闭 Eyefinity 管理覆盖层。" />
                                </StackPanel>
