                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="Radeon 后台服务"/>
                                    <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="禁用后台运行的 Radeon 服务，以释放更多资源并减少日志记录。"/>
                                    <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 禁用服务可能导致流体运动帧和 Radeon Boost 等显卡功能无法工作。&#10;&#10;* 更新或重新安装驱动程序会重新启用这些服务。"/>
                                    <Image Grid.Column="3" Style="{ThemeResource FlatHelpIcon}" x:Name="button_DisableRadeonServices_AdminShield" Source="{ThemeResource ThemeImageShield}" ToolTipService.ToolTip="更改此设置需要管理员权限；启用后，你可以继续以普通用户身份使用 RadeonTuner。"/>
                                    <Button Grid.Column="5" x:Name="button_DisableRadeonServices" Content="禁用 Radeon 服务" Click="button_DisableRadeonServices_Click" Style="{ThemeResource ApplicationButton}"/>
                                    <Button Grid.Column="6" x:Name="button_EnableRadeonServices" Content="启用 Radeon 服务" Click="button_EnableRadeonServices_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}"/>
                                </Grid>
                            </Border>

                            <!-- Check update on launch -->
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="启动时检查更新"/>
                                    <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="启动此应用程序时检查是否有可用更新。"/>
                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_StartCheckUpdate" OnContent="" OffContent="" AutomationProperties.Name="启动时检查更新" Toggled="toggleswitch_StartCheckUpdate_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Exclude drivers from Windows updates -->
