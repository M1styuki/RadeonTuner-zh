                                <Grid Margin="0,0,0,2">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Image x:Name="image_Tuning_Used" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageCheckmark}" ToolTipService.ToolTip="当前正在使用此应用程序配置。"/>
                                        <Image Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 调校应用程序配置仅在 RadeonTuner 运行时自动应用。&#10;&#10;* 启动应用程序后，可能需要几秒钟才会应用应用程序配置。"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Keep Active -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="保持生效"/>
                                        <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="当 GPU 驱动程序因意外系统故障或其他原因将配置中的调校与风扇设置重置为默认值时，自动重新应用这些设置。"/>
                                        <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 启用“保持生效”前，请确保使用稳定且经过充分测试的调校与风扇设置。&#10;&#10;* 此设置仅在 RadeonTuner 运行时有效。"/>
                                        <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_KeepActive_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_KeepActive" OnContent="" OffContent="" AutomationProperties.Name="保持生效" Toggled="toggleswitch_KeepActive_Toggled"/>
                                    </Grid>
                                </Border>

                                <!-- GPU Core Minimum -->
                                <Border Style="{ThemeResource FlatSettingRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="GPU 最低频率"/>
                                            <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="调整最低显卡频率。"/>
                                            <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 将最低频率设置得接近最高频率可能导致性能大幅下降；请通过测试性能找到最佳平衡点，或保留默认值。"/>
                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Core_Min_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
