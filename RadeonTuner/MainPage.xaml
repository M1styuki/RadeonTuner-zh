                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_Fan_Curve_4_Temp_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
                                            <Grid Margin="0,5,0,0">
