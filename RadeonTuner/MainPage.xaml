                                    <Button x:Name="button_Eyefinity_Overlay_Create" Content="创建 Eyefinity" Click="button_Eyefinity_Overlay_Create_Click" Margin="10,0,0,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="根据下方设置创建配置并启用 Eyefinity。" />
