<Page
    x:Class="RadeonTuner.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RadeonTuner"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Language="zh-CN"
    FontFamily="{StaticResource ApplicationFontFamily}"
    Loaded="page_Loaded"
    RequestedTheme="Dark"
    Background="{ThemeResource ApplicationBlackColor}"
    PointerMoved="PointerMoved_AdjustCursor">

    <Grid>
        <Grid x:Name="grid_Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <ListView x:Name="listview_Main" Grid.Column="0" SelectionMode="Single" SelectionChanged="listview_Main_SelectionChanged" Style="{ThemeResource ApplicationNavListView}">
                <ListViewItem x:Name="listviewitem_Tuning">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageTuning}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="调校"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Fans" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageFans}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="风扇"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Graphics" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageGraphics}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="显卡"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Display" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageDisplay}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="显示"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Multimedia" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageMultimedia}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="多媒体"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Settings" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageSettings}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="设置"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Information" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageInformation}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="信息"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="listviewitem_Exit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageShutdown}" Width="34" Height="34"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="13" Text="退出"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border x:Name="border_Header" Grid.Row="0" CornerRadius="10" Margin="14,12,14,0" Padding="12,10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundDarkBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="button_Update_Launch" Width="32" Height="32" ToolTipService.ToolTip="有可用更新" Click="button_Update_Launch_Click" Style="{ThemeResource ApplicationButtonImage}" Margin="0,0,8,0" Visibility="Collapsed">
                                <Image Source="{ThemeResource ThemeImageUpdate}"/>
                            </Button>
                            <Image Source="/Assets/RadeonTuner.png" Width="40" Height="40" ToolTipService.ToolTip="RadeonTuner &lt;3"/>
                        </StackPanel>

                        <ScrollViewer Grid.Column="0" Margin="0,0,10,0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <!-- Gpu Select -->
                            <Button x:Name="button_GpuSelect" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前显卡" Click="button_GpuSelect_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageVideocard}" Width="24" Height="24"/>
                                    <TextBlock x:Name="textblock_GpuSelect" Text="选择显卡" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- Display Select -->
                            <Button x:Name="button_DisplaySelect" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前显示器" Click="button_DisplaySelect_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageDisplay}" Width="24" Height="24"/>
                                    <TextBlock x:Name="textblock_DisplaySelect" Text="选择显示器" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="stackpanel_AppSelect_Graphics" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Graphics_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="24" Height="24"/>
                                        <TextBlock x:Name="textblock_AppSelect_Graphics" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Add -->
                                <Button x:Name="button_AppAdd_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Graphics_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImagePlus}" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Remove -->
                                <Button x:Name="button_AppRemove_Graphics" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Graphics_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageRemove}" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="stackpanel_AppSelect_Tuning" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Tuning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="24" Height="24"/>
                                        <TextBlock x:Name="textblock_AppSelect_Tuning" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Add -->
                                <Button x:Name="button_AppAdd_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Tuning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImagePlus}" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Remove -->
                                <Button x:Name="button_AppRemove_Tuning" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Tuning_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageRemove}" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="stackpanel_AppSelect_Display" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序" Click="button_AppSelect_Display_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="24" Height="24"/>
                                        <TextBlock x:Name="textblock_AppSelect_Display" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Add -->
                                <Button x:Name="button_AppAdd_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="添加应用程序" Click="button_AppAdd_Display_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImagePlus}" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>

                                <!-- Application Remove -->
                                <Button x:Name="button_AppRemove_Display" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="移除应用程序" Click="button_AppRemove_Display_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageRemove}" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="stackpanel_AppSelect_Multimedia" Orientation="Horizontal">
                                <!-- Application Select -->
                                <Button x:Name="button_AppSelect_Multimedia" IsEnabled="False" Margin="0,0,10,0" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="选择当前应用程序">
                                    <StackPanel Orientation="Horizontal">
                                        <Image HorizontalAlignment="Center" Source="{ThemeResource ThemeImageApps}" Width="24" Height="24"/>
                                        <TextBlock x:Name="textblock_AppSelect_Multimedia" Text="选择应用程序" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Status -->
                <Border x:Name="border_Gpu_Status" Grid.Row="1" CornerRadius="10" Margin="14,8,14,0" Padding="12,8" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="textblock_Current_Gpu_Activity" Text="..." Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="核心活动"/>
                        <TextBlock x:Name="textblock_Current_Core_Speed" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="核心频率"/>
                        <TextBlock x:Name="textblock_Current_Memory_Activity" Text="" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="显存活动"/>
                        <TextBlock x:Name="textblock_Current_Memory_Speed" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="显存频率"/>
                        <TextBlock x:Name="textblock_Current_Memory_Usage" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="显存使用量"/>
                        <TextBlock x:Name="textblock_Current_Power_Wattage" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="功耗"/>
                        <TextBlock x:Name="textblock_Current_Power_Voltage" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="电压"/>
                        <TextBlock x:Name="textblock_Current_Fan_Speed_Percentage" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="风扇转速百分比"/>
                        <TextBlock x:Name="textblock_Current_Fan_Speed_RPM" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="风扇转速 RPM"/>
                        <TextBlock x:Name="textblock_Current_Temp_Core" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="核心温度"/>
                        <TextBlock x:Name="textblock_Current_Temp_Memory" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="显存温度"/>
                        <TextBlock x:Name="textblock_Current_Temp_Hotspot" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="热点温度"/>
                        <TextBlock x:Name="textblock_Current_Temp_Intake" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" ToolTipService.ToolTip="进风温度"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Buttons -->
                <Border x:Name="border_ActionButtons" Grid.Row="2" CornerRadius="10" Margin="14,8,14,0" Padding="4" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundDarkBrush}">
                    <Grid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Tuning_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Tuning_Apply" Click="button_Tuning_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用调校与风扇设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                            <Button x:Name="button_Tuning_Reset" Click="button_Tuning_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将调校与风扇设置恢复为默认值。"/>
                            <Button x:Name="button_Tuning_Import" Click="button_Tuning_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入调校与风扇设置；导入后不会自动应用。"/>
                            <Button x:Name="button_Tuning_Export" Click="button_Tuning_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前调校与风扇设置导出到文件。"/>
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Fan_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Fan_Apply" Click="button_Tuning_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用调校与风扇设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                            <Button x:Name="button_Fan_Reset" Click="button_Tuning_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将调校与风扇设置恢复为默认值。"/>
                            <Button x:Name="button_Fan_Import" Click="button_Tuning_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入调校与风扇设置；导入后不会自动应用。"/>
                            <Button x:Name="button_Fan_Export" Click="button_Tuning_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前调校与风扇设置导出到文件。"/>
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Graphics_Buttons" ItemWidth="125" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Graphics_Apply" Click="button_Graphics_Apply_Click" Content="应用" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用显卡设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                            <Button x:Name="button_Graphics_Reset" Click="button_Graphics_Reset_Click" Content="重置" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将显卡设置恢复为默认值。"/>
                            <Button x:Name="button_Graphics_Import" Click="button_Graphics_Import_Click" Content="导入" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入显卡设置。"/>
                            <Button x:Name="button_Graphics_Export" Click="button_Graphics_Export_Click" Content="导出" Width="120" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前显卡设置导出到文件。"/>
                            <Button x:Name="button_Graphics_Clear_ShaderCache" Click="button_Graphics_Clear_ShaderCache_Click" Content="清除着色器" Width="120" ToolTipService.ToolTip="清除基于磁盘的着色器缓存内容。" Style="{ThemeResource ApplicationButton}"/>
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Display_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Display_Apply" Click="button_Display_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用显示设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                            <Button x:Name="button_Display_Reset" Click="button_Display_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将显示设置恢复为默认值。"/>
                            <Button x:Name="button_Display_Import" Click="button_Display_Import_Click" Content="导入" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="从文件导入显示设置。"/>
                            <Button x:Name="button_Display_Export" Click="button_Display_Export_Click" Content="导出" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将当前显示设置导出到文件。"/>
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Multimedia_Buttons" ItemWidth="105" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Multimedia_Apply" Click="button_Multimedia_Apply_Click" Content="应用" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="应用多媒体设置。&#10;&#10;* 绿色：设置未更改。&#10;* 橙色：设置已更改，请应用。&#10;* 红色：设置应用失败。"/>
                            <Button x:Name="button_Multimedia_Reset" Click="button_Multimedia_Reset_Click" Content="重置" Width="100" Style="{ThemeResource ApplicationButton}" ToolTipService.ToolTip="将多媒体设置恢复为默认值。"/>
                        </VariableSizedWrapGrid>
                        <VariableSizedWrapGrid x:Name="stackpanel_Information_Buttons" ItemWidth="155" ItemHeight="32" Margin="4,2,4,2" Orientation="Horizontal">
                            <Button x:Name="button_Website_Project" Content="访问项目网站" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Website_Project_Click"/>
                            <Button x:Name="button_Website_Donation" Content="打开捐赠页面" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Website_Donation_Click"/>
                            <Button x:Name="button_Fps_Overlayer" Content="获取 FpsOverlayer" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Fps_Overlayer_Click"/>
                            <Button x:Name="button_Check_Update" Content="检查更新" Width="150" Style="{ThemeResource ApplicationButton}" Click="button_Update_Check_Click"/>
                        </VariableSizedWrapGrid>
                    </Grid>
                </Border>

                <!-- Main -->
                <ScrollViewer Grid.Row="3" Margin="14,8,8,0" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,8,18">
                        <!-- Graphics -->
                        <Grid x:Name="stackpanel_Graphics" Visibility="Collapsed">
                            <!-- Settings -->
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,20,0" Text="FSR 选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                    <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Background="{ThemeResource ThemeBackgroundBrush}">
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Image Source="/Assets/WarningOrange.png" Margin="5,0,5,0" Width="24" Height="24" ToolTipService.ToolTip="* 更改下方显卡设置可能需要重启应用程序才能生效。&#10;&#10;* 由于驱动程序限制，在应用程序配置中设置的显卡设置会在你的各块显卡之间共享。&#10;&#10;* 部分设置（如“流体运动帧”和“超分辨率”）不可用，因为它们在“最小”和“仅驱动程序”软件类型安装中无法工作。"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Radeon FSR Options -->
                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
                                    <StackPanel>
                                        <!-- FSR Latency Reduction -->
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="FSR 延迟降低（Anti-Lag）通过控制 CPU 工作节奏，避免其过度领先 GPU，从而帮助减少 GPU 受限场景中的输入延迟；启用此设置可能导致轻微帧率下降。"/>
                                            <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置不适用于 OpenGL 应用程序。&#10;&#10;* 启用“Radeon Chill”时无法使用此设置。"/>
                                            <Image x:Name="image_FsrLatencyReduction_Status" Visibility="Collapsed" Source="/Assets/StatusEnabled.png" Width="24" Height="24" ToolTipService.ToolTip="..."/>
                                            <ToggleSwitch x:Name="toggleswitch_FsrLatencyReduction" Margin="10,0,0,0" OffContent="FSR 延迟降低" OnContent="FSR 延迟降低" Toggled="toggleswitch_FsrLatencyReduction_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_FsrLatencyReduction_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>

                                        <!-- FSR Multi Frame Generation Ratio -->
                                        <StackPanel x:Name="stackpanel_FsrMultiFrameGenerationRatio">
                                            <Border Margin="0,10,0,0" Height="1" Background="{ThemeResource ThemeBorderBrush}" Opacity="0.60"/>

                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="选择 FSR 多帧生成使用的帧率倍率。倍率越高，画面越流畅，但可能因游戏内运动强度而出现更多图形异常。"/>
                                                <Image Source="/Assets/WarningOrange.png" Width="24" Height="24" ToolTipService.ToolTip="* 此设置仅适用于 RDNA4 或更新显卡。&#10;&#10;* 此设置仅适用于白名单应用程序。"/>
                                                <Image Source="{ThemeResource ThemeImageExperimental}" Width="20" Height="20" ToolTipService.ToolTip="这是用于测试目的的实验性设置。"/>
                                                <TextBlock Text="FSR 多帧生成倍率" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Margin="5,0,0,0" x:Name="textblock_FsrMultiFrameGenerationRatio_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                            </StackPanel>
