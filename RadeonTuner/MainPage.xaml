                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_Power_TDC_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
                                        <Grid Style="{ThemeResource FlatControl}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
