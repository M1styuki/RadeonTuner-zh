                                        </StackPanel>
                                        <ComboBox x:Name="combobox_Display_Orientation" Margin="0,5,0,0" Width="300" Style="{ThemeResource ApplicationComboBox}" SelectionChanged="combobox_Display_Orientation_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Text="HDR 选项" Style="{ThemeResource ApplicationSectionHeader}"/>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource ThemeBorderBrush}" Background="{ThemeResource ThemeBackgroundBrush}">
