                                    <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 如果已有另一个 RadeonTuner 实例在运行，此设置将被忽略，并显示已运行实例的窗口。"/>
                                    <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_StartWindowVisible" OnContent="" OffContent="" AutomationProperties.Name="启动时显示窗口" Toggled="toggleswitch_StartWindowVisible_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Window top -->
                            <Border Style="{ThemeResource FlatSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3*"/>
