                                            <Image Source="{ThemeResource ThemeImageInformation}" Width="24" Height="24" ToolTipService.ToolTip="虚拟超级分辨率允许应用程序以高于显示器原生分辨率的分辨率渲染，再将图像缩小以匹配显示器，从而以性能为代价获得更高画质。&#10;&#10;VSR 适用于缺少抗锯齿选项或抗锯齿效果不足的游戏，这在较旧的游戏中较为常见。"/>
                                            <ToggleSwitch x:Name="toggleswitch_Display_VSR" Margin="10,0,0,0" OffContent="AMD 虚拟超级分辨率" OnContent="AMD 虚拟超级分辨率" Toggled="toggleswitch_Display_VSR_Toggled"/>
                                            <TextBlock Margin="5,0,0,0" x:Name="textblock_Display_VSR_Value" Foreground="{ThemeResource ApplicationDimGrayBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="驱动中的当前设置" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

