                                            <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_TessellationLevel_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        </Grid>
                                        <ComboBox x:Name="combobox_Tessellation_Level" Margin="0,2,0,0" Width="320" HorizontalAlignment="Left" SelectionChanged="combobox_Tessellation_Level_SelectionChanged" Style="{ThemeResource ApplicationComboBox}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Access Overlay -->
