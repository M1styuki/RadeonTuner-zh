                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{ThemeResource FlatSettingLabel}" Text="表面格式优化"/>
                                        <Image Grid.Column="1" Style="{ThemeResource FlatHelpIcon}" Source="{ThemeResource ThemeImageInformation}" ToolTipService.ToolTip="允许驱动程序覆盖应用程序并选择更优的纹理格式，以提升性能并降低显存占用，通常对画质影响很小。"/>
                                        <Image Grid.Column="2" Style="{ThemeResource FlatHelpIcon}" Source="/Assets/WarningOrange.png" ToolTipService.ToolTip="* 此设置不适用于 DirectX 12 和 Vulkan 应用程序。"/>
                                        <TextBlock Grid.Column="5" Style="{ThemeResource FlatValueLabel}" x:Name="textblock_SurfaceFormatOptimization_Value" ToolTipService.ToolTip="驱动中的当前设置"/>
                                        <ToggleSwitch Grid.Column="6" Style="{ThemeResource FlatToggleSwitch}" x:Name="toggleswitch_SurfaceFormatOptimization" OnContent="" OffContent="" AutomationProperties.Name="表面格式优化" Toggled="toggleswitch_SurfaceFormatOptimization_Toggled"/>
